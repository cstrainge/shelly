import std::io
import std::json
import std::net::http
import std::net::http::server
let $server = std::net::http::server::listen "127.0.0.1" 0
echo ready $server.address.port
fn handle($request: std::net::http::server::Incoming): std::net::http::server::Response | ErrorValue
{
    if $request.path == "/stream"
    {
        let $body = std::json::array_source [1, (), 3]
        return std::net::http::server::Response(status: 200, body: (std::net::http::source_body $body))
    }
    if $request.path == "/page1"
    { return std::net::http::server::json_response ["items":[1,()],"next":"page2"] }
    if $request.path == "/page2"
    { return std::net::http::server::json_response ["items":[2],"next":()] }
    if $request.path == "/cycle"
    { return std::net::http::server::json_response ["items":[],"next":"cycle"] }
    if $request.path == "/post"
    { return std::net::http::server::json_response ($request.read_document) }
    if $request.path == "/fail" { throw RuntimeError(what: "handler", message: "private handler detail") }
    std::net::http::server::json_response ["path": $request.path]
}
try { $server.serve `handle 7 }
finally { $server.close }
