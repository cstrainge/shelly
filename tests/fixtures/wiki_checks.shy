# Documentation checks use Shelly too; no Python or extra shell is required.
import std::json
import std::io

fn require($condition: Boolean, $message: String)
{
    if !$condition { echo $message; exit 1 }
}

fn lower($text: String): String
{
    let $upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let $lower = "abcdefghijklmnopqrstuvwxyz"
    let $result = ""
    for $character in $text.chars
    {
        let $found = false
        for $index in 0..26
        {
            if $character == $upper[$index]
            { $result = $result + $lower[$index]; $found = true; break }
        }
        if !$found { $result = $result + $character }
    }
    $result
}

fn heading_slug($text: String): String
{
    let $result = ""
    for $character in (lower $text).chars
    {
        if $character == " " { $result = $result + "-" }
        else if !("!\"#$%&'()*+,./:;<=>?@[\\]^`{|}~".contains $character)
        { $result = $result + $character }
    }
    $result
}

fn hex($character: String): Integer
{
    let $digits = "0123456789abcdef"
    for $index in 0..16
    { if (lower $character) == $digits[$index] { return $index } }
    -1
}

fn unquote($text: String): String
{
    if !($text.contains "%") { return $text }
    let $bytes: [Integer] = []
    let $index = 0
    while $index < $text.count
    {
        if ($text[$index] == "%") && ($index + 2 < $text.count)
        {
            let $high = hex $text[$index + 1]
            let $low = hex $text[$index + 2]
            if ($high >= 0) && ($low >= 0)
            {
                $bytes = [$bytes..., ($high * 16 + $low)]
                $index = $index + 3
                continue
            }
        }
        $bytes = [$bytes..., (std::io::utf8 $text[$index]).to_array...]
        $index = $index + 1
    }
    (std::io::Bytes($bytes)).decode_utf8
}

fn links($text: String): [String]
{
    let $result: [String] = []
    let $parts = $text.split "]("
    for $index in 1..$parts.count
    {
        let $prefix = $parts[$index - 1].split "["
        if ($prefix.count < 2) || ($prefix[$prefix.count - 2].ends_with "!")
        { continue }
        let $suffix = $parts[$index].split ")"
        if $suffix.count > 1 { $result = [$result..., $suffix[0]] }
    }
    $result
}

# Preserve source blocks byte-for-byte while excluding fenced code from navigation.
fn page($source: String, $slug: String): HashMap
{
    let $lines = $source.split "\n"
    let $count = $lines.count - (if $source.ends_with "\n" { 1 } else { 0 })
    if ($slug != "_Sidebar") && ($slug != "_Footer")
    {
        require ($count <= 220) "${slug}: chapter exceeds 220 lines"
        require (($source.starts_with "# ") && ($source.contains "Related: ")) \
            "${slug}: missing title or related-page navigation"
    }
    let $visible = ""
    let $fence: String | ()
    let $pending = ""
    let $code = ""
    let $examples: [String: String] = [:]
    let $anchors: [String: Boolean] = [:]
    let $table_width: Integer | ()
    for $line in $lines
    {
        if $line.starts_with "```"
        {
            if $fence != ()
            {
                if $fence == "shy" { $examples[$pending] = $code; $pending = "" }
                $fence = ()
            }
            else
            {
                $fence = $line[3..]
                if $fence == "shy"
                {
                    require (($pending != "") && ($examples[$pending] == ())) \
                        "${slug}: missing or duplicate example marker"
                    $code = ""
                }
                else { require ($pending == "") "${slug}: marker must precede Shelly code" }
            }
            continue
        }
        if $fence != ()
        { if $fence == "shy" { $code = $code + $line + "\n" }; continue }
        require ($pending == "") "${slug}: marker must immediately precede its code block"
        if ($line.starts_with "<!-- example: ") && ($line.ends_with " -->")
        { $pending = (($line.split ": ")[1].split " -->")[0] }
        $visible = $visible + $line + "\n"
        if $line.starts_with "#"
        {
            let $title = $line
            while $title.starts_with "#" { $title = $title[1..] }
            let $base = heading_slug $title.trim
            let $anchor = $base
            let $suffix = 0
            while $anchors[$anchor] != ()
            { $suffix = $suffix + 1; $anchor = "${base}-${suffix}" }
            $anchors[$anchor] = true
        }
        if $line.starts_with "|"
        {
            let $width = 1
            let $previous = ""
            for $character in $line.chars
            {
                if ($character == "|") && ($previous != "\\") { $width = $width + 1 }
                $previous = $character
            }
            require (($table_width == ()) || ($table_width == $width)) \
                "${slug}: inconsistent table columns"
            $table_width = $width
        }
        else { $table_width = () }
    }
    require ($fence == ()) "${slug}: unclosed code fence"
    require ($pending == "") "${slug}: example marker has no code block"
    ["visible": $visible, "examples": $examples, "anchors": $anchors]
}

pub fn check($directory: String, $manifest: String): Integer
{
    require (dir_exists $directory) "wiki directory is missing"
    let $listing: String
    find $directory -maxdepth 1 -name "\x2a.md" -type f -print -> $listing
    let $pages = [:]
    let $examples = [:]
    let $chapters = 0
    for $file in $listing.trim_end.split "\n"
    {
        if $file == "" { continue }
        let $parts = $file.split "/"
        let $slug = $parts[$parts.count - 1].strip_suffix ".md"
        let $source: String
        $file -> $source
        let $page = page $source $slug
        $pages[$slug] = $page
        for ($id, $code) in $page["examples"]
        {
            require ($examples[$id] == ()) "${slug}: duplicate example ${id}"
            $examples[$id] = [$slug, $code]
        }
        if ($slug != "_Sidebar") && ($slug != "_Footer") { $chapters = $chapters + 1 }
    }
    for $required in ["Home", "_Sidebar", "_Footer"]
    { require ($pages[$required] != ()) "wiki is missing ${required}" }
    let $sidebar: [String: Boolean] = [:]
    let $link_count = 0
    for ($slug, $page) in $pages
    {
        for $target in links $page["visible"]
        {
            if $target.contains ":" { continue }
            let $parts = (unquote $target).split "#"
            let $destination = $parts[0].strip_suffix ".md"
            if $destination == "" { $destination = $slug }
            require ($pages[$destination] != ()) "${slug}: missing target ${target}"
            if ($parts.count > 1) && ($parts[1] != "")
            { require ($pages[$destination]["anchors"][$parts[1]] == true) \
                "${slug}: missing heading ${target}" }
            if $slug == "_Sidebar" { $sidebar[$destination] = true }
            $link_count = $link_count + 1
        }
    }
    for ($slug, _) in $pages
    {
        if ($slug != "_Sidebar") && ($slug != "_Footer")
        { require ($sidebar[$slug] == true) "${slug}: absent from sidebar" }
    }
    let $text: String
    $manifest -> $text
    let $cases: Array = std::json::decode $text
    let $expected = [:]
    for $case in $cases
    {
        let $id = $case["id"]
        require ($case["source"] == $case["blocks"][$id]) \
            "${id}: runner source differs from documented source"
        let $fixtures: [String] = []
        for ($block, $code) in $case["blocks"]
        {
            require ($expected[$block] == ()) "duplicate manifest block ${block}"
            $expected[$block] = [$case["page"], $code]
            if $block != $id { $fixtures = [$fixtures..., $code] }
        }
        let $files: [String] = []
        if $case["files"] != ()
        { for (_, $contents) in $case["files"] { $files = [$files..., $contents] } }
        require ($fixtures.sort == $files.sort) "${id}: fixture files differ from documented blocks"
    }
    for ($id, $entry) in $expected
    { require ($examples[$id] == $entry) "${id}: wiki/manifest mismatch" }
    require ($examples.count == $expected.count) "wiki contains an unlisted example"
    echo "Checked" $chapters "wiki chapters," $link_count "links and" $cases.count "examples."
    $chapters
}
