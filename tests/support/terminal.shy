# PTY interaction, terminal protocol handling and assertions are Shelly code.
fn fail($message: String)
{
    echo "FAIL: $message"
    exit 1
}

fn require($condition: Boolean, $message: String)
{
    if !$condition { fail $message }
}

fn strip_ansi($text: String): String
{
    let $output = ""
    let $state = "text"
    let $final = "@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    for $character in $text.chars
    {
        if $state == "escape"
        {
            $state = if $character == "[" { "csi" } else { "text" }
        }
        else if $state == "csi"
        {
            if ($final.contains $character) { $state = "text" }
        }
        else if $character == "\x1b" { $state = "escape" }
        else if $character != "\r" { $output = "${output}${character}" }
    }
    $output
}

fn drain($terminal: Terminal)
{
    let $raw = ""
    for $attempt in 0..50
    {
        let $reply = terminal_read $terminal 100
        let $text = $reply["text"]
        $raw = "${raw}${text}"
        if ($raw.contains "\x1b[6n")
        {
            terminal_write $terminal "\x1b[1;1R"
            $raw = $raw.replace "\x1b[6n" ""
        }
        if ($raw.contains "\x1b[c")
        {
            terminal_write $terminal "\x1b[?1;2c"
            $raw = $raw.replace "\x1b[c" ""
        }
        let $output = strip_ansi $raw
        if $reply["eof"] || ($reply["timed_out"] &&
            (($output.ends_with "\n$ ") || ($output.ends_with "\n# ")))
        {
            return ["output": $output, "eof": $reply["eof"],
                    "exit_code": $reply["exit_code"], "signal": $reply["signal"]]
        }
    }
    fail "terminal did not reach a prompt or EOF"
}

fn submit($terminal: Terminal, $source: String)
{
    terminal_write $terminal "\x1b[200~${source}\x1b[201~\r"
    drain $terminal
}

fn session($fixture: String): Terminal
{
    open_terminal [`$shelly, "--norc", "-m", "-b"] [
        "cwd": $fixture, "env": ["HOME": $fixture,
            "PATH": "${fixture}/bin:/usr/bin:/bin", "TERM": "xterm-256color", "LANG": "C.UTF-8"],
        "rows": 40, "columns": 140,
    ]
}

fn check_repl($case: HashMap)
{
    let $fixture = $args[0]
    let $terminal = session $fixture
    let $initial = drain $terminal
    require (!$initial["eof"]) "shell exited during startup"
    for ($source, $kind, $expected) in $case["steps"]
    {
        let $reply = submit $terminal ($source.replace "<FIXTURE>" $fixture)
        let $output = $reply["output"].replace $fixture "<FIXTURE>"
        if !(repl_matches $kind $expected $output)
        {
            echo $output
            fail "wrong REPL output or diagnostic"
        }
        require ($reply["eof"] == ($case["exit"] == 7)) "unexpected EOF or missing exit"
        if $case["id"] == "R013" { require ($output.contains "[~]") "home prompt not shortened" }
    }
    if $case["exit"] == 0
    {
        terminal_write $terminal "\x04"
        let $closed = drain $terminal
        require $closed["eof"] "Ctrl+D did not close shell"
    }
    let $status = terminal_close $terminal
    require ($status["exit_code"] == $case["exit"]) "wrong REPL exit status"
    require ($status["signal"] == ()) "REPL terminated by signal"
}

fn repl_matches($kind: String, $expected: String, $output: String): Boolean
{
    if ($output.contains "panicked at") || ($output.contains "stack overflow") { return false }
    let $lines = "\n${output}"
    let $error = $lines.contains "\nError processing text:"
    if $kind == "error"
    {
        if !$error { return false }
        let $diagnostic = ($lines.split "\nError processing text:")[1]
        return $diagnostic.contains $expected
    }
    if $error { return false }
    if $kind == "quiet" { return true }
    ($kind == "output") && ($output.contains "\n${expected}\n")
}

# Raw PTY assertions for multiline capability detection and monochrome rendering.
fn check_multiline_colors($cases: Array)
{
    fn raw_edit_keys($terminal: Terminal, $keys: String): String
    {
        terminal_write $terminal $keys
        let $raw = ""
        for $attempt in 0..50
        {
            let $reply = terminal_read $terminal 100
            require (!$reply["eof"]) "editor exited while editing"
            $raw = $raw + $reply["text"]
            if $reply["timed_out"] { return $raw }
        }
        fail "editor did not settle"
    }

    # Reedline may emit a reset; monochrome must never enable a color or style.
    fn require_monochrome($raw: String, $monochrome: Boolean)
    {
        if !$monochrome { return }
        let $chunks = ($raw.replace "\x1b[0m" "").split "\x1b["
        for $index in 1..$chunks.count
        {
            for $character in $chunks[$index].chars
            {
                if ("@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~".contains $character)
                {
                    require ($character != "m") "monochrome editor emitted styling"
                    break
                }
            }
        }
    }

    let $ctrl_enter = "\x1b[13;5u"
    let $paste_start = "\x1b[200~"
    let $paste_end = "\x1b[201~"

    for ($term, $color_term, $mono, $no_color, $yellow) in $cases
    {
        let $monochrome = $mono || $no_color || ($term == "dumb")
        let $environment = ["HOME": $args[0], "PATH": "/usr/bin:/bin", "TERM": $term,
                            "LANG": "C.UTF-8"]
        if $color_term != "" { $environment["COLORTERM"] = $color_term }
        if $no_color { $environment["NO_COLOR"] = "1" }
        let $options = if $mono { ["--norc", "-m", "-b"] } else { ["--norc", "-b"] }
        let $terminal = open_terminal [`$shelly, $options...] [
            "cwd": $args[0], "env": $environment, "rows": 40, "columns": 140,
        ]
        let _ = drain $terminal
        let $raw = raw_edit_keys $terminal "${paste_start}let \$colored = [1,${paste_end}"
        require_monochrome $raw $monochrome
        require (!(($raw.contains "\x1b[33m$ ") || ($raw.contains "\x1b[33m# "))) "normal prompt marker is yellow"
        let $raw = raw_edit_keys $terminal $ctrl_enter
        require_monochrome $raw $monochrome
        let $has_yellow = ($raw.contains "\x1b[33m$ ") || ($raw.contains "\x1b[33m# ")
        require ($has_yellow == $yellow) "multiline prompt color does not match terminal capability"
        let $raw = raw_edit_keys $terminal "\r2]"
        require_monochrome $raw $monochrome
        require (($raw.contains "\x1b[33m\r\n> ") == $yellow) "wrong continuation color"
        let $raw = raw_edit_keys $terminal $ctrl_enter
        require_monochrome $raw $monochrome
        require (!(($raw.contains "\x1b[33m$ ") || ($raw.contains "\x1b[33m# "))) "submission retained yellow marker"
        let $reply = submit $terminal "echo \$colored..."
        require (repl_matches "output" "1 2" $reply["output"]) "color changed input contents"
        let _ = raw_edit_keys $terminal $ctrl_enter
        let $raw = raw_edit_keys $terminal "\x03"
        require_monochrome $raw $monochrome
        require (!(($raw.contains "\x1b[33m$ ") || ($raw.contains "\x1b[33m# "))) "cancellation retained yellow marker"
        let $reply = submit $terminal "let \$mono_one = 1; let \$mono_two = 2"
        let $raw = raw_edit_keys $terminal "${paste_start}echo \$mono_${paste_end}\t\t"
        require_monochrome $raw $monochrome
        terminal_write $terminal "\x03"
        let _ = drain $terminal
        terminal_write $terminal "\x04"
        let _ = drain $terminal
        let $status = terminal_close $terminal
        require ($status["exit_code"] == 0) "color session failed"
    }
}
