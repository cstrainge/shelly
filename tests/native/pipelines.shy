pipeline_case "head -c 32768 /dev/urandom -> \"<FIXTURE>/bytes\"; cat \"<FIXTURE>/bytes\" | cat | cmp \"<FIXTURE>/bytes\" \"-\"; echo binary" "binary\n" ""
