# Typed values, byte streams, conversion boundaries and aggregate process status.
fn pipeline_case($source: String, $stdout: String, $diagnostic: String)
{
    let $fixture = $args[0]
    $source = $source.replace "<FIXTURE>" $fixture
    let $reply = run_process [`$shelly, "-m", "-c", $source] [
        "cwd": $fixture, "env": ["HOME": $fixture, "PATH": "${fixture}/bin:/usr/bin:/bin",
            "SHELLY_STD_PATH": "${fixture}/std:bundled", "TERM": "dumb", "LANG": "C.UTF-8"],
        "stdin_file": "/dev/null", "stdout_file": "${fixture}/out",
        "stderr_file": "${fixture}/err", "timeout_ms": 5000]
    let $out: String
    let $err: String
    "${fixture}/out" -> $out
    "${fixture}/err" -> $err
    let $status = if $diagnostic == "" { 0 } else { 1 }
    if ($out != $stdout) || ($reply["exit_code"] != $status) ||
        ($reply["error"] != ()) || ($reply["signal"] != ()) || $reply["timed_out"] ||
        (($diagnostic == "") && ($err != "")) ||
        (($diagnostic != "") && (!($err.contains $diagnostic)))
    { echo $source $reply $out $err; fail "pipeline mismatch" }
}

pipeline_case "fn add(\$x: Integer): Integer { \$x + 1 }; echo (7 | add | (\$ * 2))" "16\n" ""
pipeline_case "fn join(\$a: String, \$b: String, \$c: String): String { \$a + \$b + \$c }; echo (\"b\" | join \"a\" \$ \"c\")" "abc\n" ""
pipeline_case "fn add(\$a: Integer, \$b: Integer): Integer { \$a + \$b }; echo (7 | add \$ \$)" "14\n" ""
pipeline_case "let \$offset = 2; echo (7 | (\$ + \$offset))" "9\n" ""
pipeline_case "fn unit(\$x: Integer) {}; fn inspect(\$x: any): String { if \$x == () { \"unit\" } else { \"old\" } }; echo (7 | unit | inspect)" "unit\n" ""
pipeline_case "echo (7 | ((\$ | (\$ + 1)) + \$))" "15\n" ""
pipeline_case "echo ([[1,2]] | \$.count)" "2\n" ""
pipeline_case "struct Box { pub n: Integer }; echo (Box(n: 7) | \$.n)" "7\n" ""
pipeline_case "type Count = Integer; echo (Count(7) | \$.type)" "Count\n" ""
pipeline_case "let \$f = fn (\$x: Integer): Integer { \$x + 1 }; let \$out: Integer; 7 | \$f | \$out; echo \$out" "8\n" ""
pipeline_case "let \$out: Float; 7 | \$out; echo \$out" "7.0\n" ""
pipeline_case "let \$out: [Float]; 7 | \$out; echo \$out[0]" "7.0\n" ""
pipeline_case "let \$out = [99]; 7 | \$out; echo \$out..." "7\n" ""
pipeline_case "let \$out = 99; 7 | \$out; echo \$out" "7\n" ""
pipeline_case "type Items = [Integer]; let \$out: Items; 7 | \$out; echo \$out.type \$out[0]" "Items 7\n" ""
pipeline_case "printf hello | cat | cat" "hello" ""
pipeline_case "let \$out: String; let \$status = printf hello | cat | \$out; echo \$out \$status" "hello ExecResult(0)\n" ""
pipeline_case "fn text(\$x: String): Integer { \$x.chars.count }; echo (printf hello | text)" "ExecResult(0)\n" ""
pipeline_case "fn text(\$x: String): String { \$x + \"!\" }; let \$out: String; printf hello | text | \$out; echo \$out" "hello!\n" ""
pipeline_case "fn text(\$x: String): String { \$x + \"!\" }; let \$out: String; printf \"\" | text | \$out; echo \$out" "!\n" ""
pipeline_case "let \$status = /usr/bin/false | cat; echo \$status" "ExecResult(1)\n" ""
pipeline_case "let \$status = printf hello | /usr/bin/false; echo \$status" "ExecResult(1)\n" ""
pipeline_case "/usr/bin/false | cat" "" "Executable returned error code: 1"
pipeline_case "let \$status = yes x | head -n 1; echo \$status; echo alive" "x\nExecResult(Signaled)\nalive\n" ""
pipeline_case "let \$rows: [[String]]; printf \"a,b\\nc,d\\n\" csv:| \$rows; echo \$rows.count \$rows[0]... \$rows[1]..." "2 a b c d\n" ""
pipeline_case "let \$row: [String]; printf \"a,b\\nc,d\\n\" csv:| \$row" "" "Expected String"
pipeline_case "let \$out: String; fn last(\$row: [String]): String { \$row[1] }; printf \"a,b\\nc,d\\n\" csv:| last | \$out; echo \$out" "d\n" ""
pipeline_case "let \$out: [String]; fn last(\$row: [String]): String { \$row[1] }; printf \"a,b\\nc,d\\n\" csv:| last | \$out; echo \$out..." "b d\n" ""
pipeline_case "let \$out: [[String]]; printf \"\" csv:| \$out; echo \$out.count" "0\n" ""
pipeline_case "let \$out: String = \"old\"; printf \"\" csv:| \$out; echo \$out" "old\n" ""
pipeline_case "let \$rows: [[String]]; printf \"a\\tb\\nc\\td\\n\" tsv:| \$rows; echo \$rows.count \$rows[1]..." "2 c d\n" ""
pipeline_case "let \$rows: [[String]]; printf \"a b\\nc d\\n\" ssv:| \$rows; echo \$rows.count \$rows[1]..." "2 c d\n" ""
