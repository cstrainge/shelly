pipeline_case "fn show(\$a: String, \$b: String): String { \$a + \$b }; \"x\" | show \"a\" \"b\"" "" "must use bare \$"
pipeline_case "7 | \$missing" "" "not found"
pipeline_case "let \$out: String; 7 | \$out" "" "Expected String"
pipeline_case "echo \$" "" "Bare \$ is only available"
pipeline_case "[1] |:missing cat" "" "Unsupported format"
