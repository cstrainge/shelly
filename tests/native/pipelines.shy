pipeline_case "let \$rows: [[String]]; printf \"%s\" \"\\\"a\\\"\\\"b\\\",,z\\n\" csv:| \$rows; echo \$rows[0][0] \$rows[0][1].chars.count \$rows[0][2]" "a\"b 0 z\n" ""
