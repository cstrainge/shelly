pipeline_case "struct Reply { pub n: Integer }; let \$out = Reply(n: 0); printf \"%s\" \"{\\\"n\\\":42}\" json:|:Reply \$out; echo \$out.n" "42\n" ""
pipeline_case "struct Inner { pub n: Integer }; struct Reply { pub inner: Inner, pub ok: Boolean }; let \$out = Reply(inner: Inner(n: 0), ok: true); printf \"%s\" \"{\\\"inner\\\":{\\\"n\\\":42},\\\"ok\\\":false}\" json:|:Reply \$out; echo \$out.inner.n \$out.ok" "42 false\n" ""
pipeline_case "struct Row { pub name: String, pub n: Integer, pub ok: Boolean }; let \$rows: [Row]; printf \"name,n,ok\\nx,7,false\\ny,8,true\\n\" csv:|:Row \$rows; echo \$rows.count \$rows[0].n \$rows[0].ok \$rows[1].ok" "2 7 false true\n" ""
pipeline_case "type Count = Integer; let \$out: Count; printf 7 json:|:Count \$out; echo \$out.type \$out" "Count 7\n" ""
pipeline_case "type Count = Integer; fn Count::from_integer(\$n: Integer): Count { \$n + 1 }; let \$out: Count; printf 7 json:|:Count \$out; echo \$out" "7\n" ""
pipeline_case "type wire = String; fn String::from_wire(\$x: Integer): String { \"n=\" + String(\$x) }; fn wire::from_string(\$x: String): wire { \$x }; let \$out: wire; 7 |:wire cat wire:| \$out; echo \$out" "n=7\n" ""
pipeline_case "fn noisy(\$x: Integer): Integer { echo side; \$x + 1 }; let \$captured: String; let \$out: Integer; 7 | noisy -> \$captured | \$out; echo \$out \$captured" "8 side\n\n" ""
