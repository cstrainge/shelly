let $fixture = $args[0]
printf "%s" "echo \"a,b\"\nlet \$marker = \$args[0]\nfor \$attempt in 0..100\n{\n    if (test -f \$marker) { echo \"c,d\"; exit 0 }\n    sleep 0.01\n}\nexit 8\n" -> "${fixture}/producer.shy"
printf "%s" "pub type wire = String\npub fn String::from_wire(\$x: Integer): String { \"encoded-\" + String(\$x) }\npub fn wire::from_string(\$x: String): wire { \$x }\n" -> "${fixture}/codec.shy"
printf "%s" "pub struct Counter { pub n: Integer }\npub fn Counter::next_item(): Integer | () { if \$self.n == 0 { return () }; \$self.n = \$self.n - 1; \$self.n }\n" -> "${fixture}/iterable.shy"
pipeline_case "import iterable::{ Counter }; let \$out: [Integer]; Counter(n: 2) | (\$ + 1) | \$out; echo \$out..." "2 1\n" ""
pipeline_case "struct Row { pub n: Integer }; type Rows = [Row]; let \$out: Rows; printf \"n\\n1\\n2\\n\" csv:|:Rows \$out; echo \$out.type \$out[0].n \$out[1].n" "Rows 1 2\n" ""
