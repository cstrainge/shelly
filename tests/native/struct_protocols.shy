protocol_case 'struct Basket { items: [Integer] }; let $gets = 0; let $sets = 0; fn Basket::new(): Basket { Basket(items: [3,1,2]) }; fn Basket::get_items(): [Integer] { $gets = $gets + 1; $self.::items }; fn Basket::set_items($v: [Integer]) { $sets = $sets + 1; $self.::items = $v }; fn Array::order(): [Integer] { $self = $self.sort; $self }; let $b = Basket(); $b.items.order; echo $gets $sets; echo $b.items...' "1 1\n1 2 3\n" ""
protocol_case 'struct Basket { items: [Integer] }; fn Basket::new(): Basket { Basket(items: [3,1,2]) }; fn Basket::get_items(): [Integer] { $self.::items }; fn Basket::set_items($v: [Integer]) { $self.::items = $v }; fn Array::order(): [Integer] { $self = $self.sort; $self }; let $b = Basket(); let $sort = `$b.items.order; $b.items = [8,6,7]; $sort; echo $b.items...; $b.items = [5,4]; $sort; echo $b.items...' "6 7 8\n4 5\n" ""
protocol_case 'struct Basket { items: [Integer] }; fn Basket::new(): Basket { Basket(items: [3,1,2]) }; fn Basket::get_items(): [Integer] { $self.::items }; fn Array::order(): [Integer] { $self = $self.sort; $self }; let $b = Basket(); $b.items.order' "" "read-only"
protocol_case 'struct Inner { items: [Integer] }; fn Inner::new(): Inner { Inner(items: [3,1,2]) }; fn Inner::get_items(): [Integer] { $self.::items }; fn Inner::set_items($v: [Integer]) { $self.::items = $v }; struct Outer { child: Inner }; fn Outer::new($child: Inner): Outer { Outer(child: $child) }; fn Outer::get_child(): Inner { $self.::child }; fn Outer::set_child($v: Inner) { $self.::child = $v }; fn Array::order(): [Integer] { $self = $self.sort; $self }; let $o = Outer(child: Inner()); $o.child.items.order; echo $o.child.items...' "1 2 3\n" ""
