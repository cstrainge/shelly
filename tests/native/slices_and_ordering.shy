slice_case "echo [10,20,30,40][4..4].count" "0\n" ""
slice_case "echo [][..].count [][0..].count [][..0].count" "0 0 0\n" ""
slice_case "let \$r = 1..3; let \$a = [1,2,3]; echo \$a[\$r]..." "2 3\n" ""
