slice_case "let \$a = [10,20,30,40]; echo \$a[..2]..." "10 20\n" ""
slice_case "let \$a = [10,20,30,40]; echo \$a[..=2]..." "10 20 30\n" ""
slice_case "let \$a = [10,20,30,40]; echo \$a[..]..." "10 20 30 40\n" ""
slice_case "let \$a = [10,20,30,40]; echo \$a[0..4]..." "10 20 30 40\n" ""
