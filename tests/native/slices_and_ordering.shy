# Range slices and numeric ordering: exact output, type propagation, and rejected operations.
fn slice_case($source: String, $stdout: String, $diagnostic: String)
{
    let $fixture = $args[0]
    let $reply = run_process [`$shelly, "-m", "-c", $source] [
        "cwd": $fixture, "env": ["HOME": $fixture, "PATH": "/usr/bin:/bin",
            "SHELLY_STD_PATH": "", "TERM": "dumb", "LANG": "C.UTF-8"],
        "stdin_file": "/dev/null", "stdout_file": "${fixture}/out",
        "stderr_file": "${fixture}/err", "timeout_ms": 3000]
    let $out: String
    let $err: String
    "${fixture}/out" -> $out
    "${fixture}/err" -> $err
    let $status = if $diagnostic == "" { 0 } else { 1 }
    if ($out != $stdout) || ($reply["exit_code"] != $status) ||
        ($reply["error"] != ()) || ($reply["signal"] != ()) || $reply["timed_out"] ||
        (($diagnostic == "") && ($err != "")) ||
        (($diagnostic != "") && (!($err.contains $diagnostic)))
    { echo $source $reply $out $err; fail "slice or ordering mismatch" }
}
slice_case "fn Array::min(): Number\n{\n    let \$value = \$self[0]\n    for \$next in \$self[1..]\n    {\n        if \$next < \$value\n        {\n            \$value = \$next\n        }\n    }\n    \$value\n}\necho [4,2,6,-3,5].min [9].min [2,1.5,3].min [-3,-3,0].min" "-3 9 1.5 -3\n" ""
slice_case "fn Array::min(): Number\n{\n    let \$value = \$self[0]\n    for \$next in \$self[1..]\n    {\n        if \$next < \$value\n        {\n            \$value = \$next\n        }\n    }\n    \$value\n}\nlet \$a = [4,2,6]; echo \$a.min \$a..." "2 4 2 6\n" ""
slice_case "fn Array::min(): Number\n{\n    let \$value = \$self[0]\n    for \$next in \$self[1..]\n    {\n        if \$next < \$value\n        {\n            \$value = \$next\n        }\n    }\n    \$value\n}\necho [].min" "" "out of bounds for length 0"
slice_case "fn Array::min(): Number\n{\n    let \$value = \$self[0]\n    for \$next in \$self[1..]\n    {\n        if \$next < \$value\n        {\n            \$value = \$next\n        }\n    }\n    \$value\n}\necho [1,\"two\"].min" "" "Ordering comparisons require numbers"
slice_case "let \$a = [10,20,30,40]; echo \$a[1..3]..." "20 30\n" ""
