# Receiver-dependent method contracts specialize from collection metadata.
let $fixture = $args[0]
fn receiver_annotation_case($source: String, $stdout: String, $diagnostic: String)
{
    let $reply = run_process [`$shelly, "-m", "-c", $source] [
        "cwd": $fixture, "env": ["PATH": "/usr/bin:/bin", "SHELLY_STD_PATH": ""],
        "stdout_file": "${fixture}/out", "stderr_file": "${fixture}/err",
        "timeout_ms": 3000]
    let $out: String
    let $err: String
    "${fixture}/out" -> $out
    "${fixture}/err" -> $err
    let $status = if $diagnostic == "" { 0 } else { 1 }
    require (($reply["exit_code"] == $status) && ($reply["signal"] == ()) &&
        ($reply["error"] == ()) && (!$reply["timed_out"]) && ($out == $stdout)) "${source}: ${out} ${err}"
    if $diagnostic == "" { require ($err == "") $source }
    else { require ($err.contains $diagnostic) "${source}: ${err}" }
}
receiver_annotation_case "fn Array::push(\$value: \$self.value_type) { \$self = [\$value, \$self...] }; let \$a: [Integer] = []; \$a.push 2; \$a.push 1; echo \$a..." "1 2\n" ""
