# Literal interpolation and dynamic members share normal field resolution and writes.
let $fixture = $args[0]
fn member_case($source: String, $expected: String, $diagnostic: String)
{
    let $fixture = $args[0]
    let $reply = run_process [`$shelly, "-m", "-c", $source] [
        "cwd": $fixture, "env": ["HOME": $fixture, "PATH": "/usr/bin:/bin",
            "SHELLY_STD_PATH": "", "LANG": "C.UTF-8"],
        "stdin_file": "/dev/null", "stdout_file": "${fixture}/out",
        "stderr_file": "${fixture}/err", "timeout_ms": 3000]
    let $out: String
    let $err: String
    "${fixture}/out" -> $out
    "${fixture}/err" -> $err
    let $status = if $diagnostic == "" { 0 } else { 1 }
    if ($out != $expected) || ($reply["exit_code"] != $status) ||
        ($reply["error"] != ()) || ($reply["signal"] != ()) || $reply["timed_out"] ||
        (($diagnostic == "") && ($err != "")) ||
        (($diagnostic != "") && (!($err.contains $diagnostic)))
    { echo $source $reply $out $err; fail "dynamic members mismatch" }
}
member_case 'struct Person { pub name: String, pub age: Integer }; let $p = Person(name: "Ada", age: 36); let $field = "age"; echo "${p.name}: ${p.$field}"; $p.$field = 37; echo $p.age; $field = "name"; $p.$field = "Grace"; echo "${p.name}"' "Ada: 36\n37\nGrace\n" ""
