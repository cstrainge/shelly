# Collection metadata is typed, read-only data and appears in reflection.
let $fixture = $args[0]
fn collection_property_case($source: String, $stdout: String, $diagnostic: String): any
{
    let $reply = run_process [`$shelly, "-m", "-c", $source] [
        "cwd": $fixture, "env": ["PATH": "/usr/bin:/bin", "SHELLY_STD_PATH": ""],
        "stdout_file": "${fixture}/out", "stderr_file": "${fixture}/err",
        "timeout_ms": 3000]
    let $out: String
    let $err: String
    "${fixture}/out" -> $out
    "${fixture}/err" -> $err
    let $status = if $diagnostic == "" { 0 } else { 1 }
    require (($reply["exit_code"] == $status) && ($reply["signal"] == ()) &&
        ($reply["error"] == ()) && (!$reply["timed_out"]) && ($out == $stdout)) "${source}: ${out} ${err}"
    if $diagnostic == "" { require ($err == "") $source }
    else { require ($err.contains $diagnostic) "${source}: ${err}" }
}
collection_property_case "echo [1,2].value_type [1.0,2.0].value_type [\"a\",\"b\"].value_type [].value_type [1,\"a\"].value_type [1,1.0].value_type" "Integer Float String any any any\n" ""
collection_property_case "echo [\"a\":1].key_type [\"a\":1].value_type [:].key_type [:].value_type [\"a\":1,2:\"b\"].key_type [\"a\":1,2:\"b\"].value_type" "String Integer any any any any\n" ""
collection_property_case "let \$a: [Float] = []; let \$h: [String: Integer] = [:]; echo \$a.value_type \$h.key_type \$h.value_type" "Float String Integer\n" ""
collection_property_case "let \$a: [Number] = [1]; let \$b: [any] = [1]; let \$h: [any: any] = [\"x\":1]; echo \$a.value_type \$b.value_type \$h.key_type \$h.value_type" "Number any any any\n" ""
collection_property_case "let \$a: [Integer, String] = [1,\"s\"]; echo \$a.value_type [[1,2],[3]].value_type" "any [Integer]\n" ""
collection_property_case "type Count = Integer; type Items = [Float]; let \$a: [Count] = [1]; let \$items: Items = []; echo (\$a.value_type == Count) \$items.value_type Items([]).value_type" "true Float Float\n" ""
collection_property_case "type Key = String; let \$h: [Key: Float] = [:]; echo (\$h.key_type == Key) \$h.value_type" "true Float\n" ""
collection_property_case "struct Item { pub rows: [Float], pub counts: [String: Integer] }; let \$a = Item(rows: [], counts: [:]); echo \$a.rows.value_type \$a.counts.key_type \$a.counts.value_type" "Float String Integer\n" ""
collection_property_case "struct Item { pub rows: [Float] }; let \$a = [Item(rows: [])]; echo \$a[0].rows.value_type" "Float\n" ""
collection_property_case "let \$a: [[Float]] = [[]]; let \$h: [String: [Integer]] = [\"x\": []]; echo \$a[0].value_type \$h[\"x\"].value_type" "Float Integer\n" ""
collection_property_case "let \$a: [Float] = []; fn Array::item_type(): Type { \$self.value_type }; echo \$a.item_type; let \$h: [String: Integer] = [:]; fn HashMap::item_type(): Type { \$self.value_type }; echo \$h.item_type" "Float\nInteger\n" ""
collection_property_case "fn types(\$a: [Number], \$h: [String: Float]): any { echo \$a.value_type \$h.key_type \$h.value_type }; types [] [:]" "Number String Float\n" ""
collection_property_case "let \$a = [1]; echo \$a.value_type; \$a[0] = \"s\"; echo \$a.value_type; \$a = [1,\"s\"]; echo \$a.value_type" "Integer\nString\nany\n" ""
collection_property_case "let \$a: [Float] = []; let \$p = \$a.properties; echo \$p[\"value_type\"] (\$p[\"value_type\"].type == Type); let \$h: [String: Integer] = [:]; let \$p = \$h.properties; echo \$p[\"key_type\"] \$p[\"value_type\"]" "Float true\nString Integer\n" ""
collection_property_case "let \$a = [1]; let \$saved = `\$a.properties; let \$p = (\$saved); \$a = [\"s\"]; echo \$p[\"value_type\"] (\$saved)[\"value_type\"]" "Integer String\n" ""
collection_property_case "let \$a: [Float] | [String] = [1]; echo \$a.value_type; let \$b: [Float] | [String] = []; echo \$b.value_type" "Float\nany\n" ""
collection_property_case "let \$a: [Float] | () = []; echo \$a.value_type" "Float\n" ""
collection_property_case "let \$t: Type = [1].value_type; echo (\$t == Integer); fn item(\$a: Array): Type { \$a.value_type }; echo (item [1])" "true\nInteger\n" ""
collection_property_case "struct Item { pub value_type: String, pub key_type: Integer }; let \$a = Item(value_type:\"field\",key_type:9); echo \$a.value_type \$a.key_type" "field 9\n" ""
collection_property_case "fn any::value_type(): String { \"scalar\" }; echo (1).value_type [1].value_type" "scalar Integer\n" ""
collection_property_case "let \$a = [1]; \$a.value_type = String" "" "read-only"
collection_property_case "let \$h = [\"x\":1]; \$h.key_type = Integer" "" "read-only"
collection_property_case "let \$h = [\"x\":1]; \$h.value_type = String" "" "read-only"
collection_property_case "type Items = [Integer]; let \$a: Items = [1]; \$a.value_type = String" "" "read-only"
collection_property_case "fn Array::value_type(): Type { Integer }" "" "conflicts with a data member"
collection_property_case "fn HashMap::key_type(): Type { String }" "" "conflicts with a data member"
collection_property_case "fn HashMap::value_type(): Type { String }" "" "conflicts with a data member"
collection_property_case "let \$bad: Integer = [1].value_type" "" "Expected Integer, got Type"
collection_property_case "echo [1].key_type" "" "Cannot access field"
collection_property_case "echo (1).value_type" "" "Cannot access"
collection_property_case "let \$a: [Float] = []; echo \$a[..].value_type; let \$b: [Number, Float] = [1,2]; echo \$b[0..1].value_type \$b[1..].value_type" "Float\nNumber Float\n" ""
collection_property_case "let \$a: [Float] = []; let \$p = \$a.properties; \$p[\"value_type\"] = Integer; echo \$a.value_type" "Float\n" ""
