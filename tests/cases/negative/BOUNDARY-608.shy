# BOUNDARY-608: equals in variable name / ${bad=name} = 1
check ["id": "BOUNDARY-608",
    "name": "equals in variable name / \${bad=name} = 1",
    "source": "echo \"PARSE_SENTINEL\"; \${bad=name} = 1",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "Parser error:",
    "stderr_contains": ["Invalid variable name: '=' is not allowed."],
    "stderr_excludes": [],
    "stdout_excludes": []]
