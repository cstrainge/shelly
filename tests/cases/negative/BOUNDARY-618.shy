# BOUNDARY-618: equals in interpolated variable name / echo "${bad=name}"
check ["id": "BOUNDARY-618",
    "name": "equals in interpolated variable name / echo \"\${bad=name}\"",
    "source": "echo \"\${bad=name}\"; echo \"AFTER_ERROR\"",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "Invalid variable name:",
    "stderr_contains": ["Invalid variable name: '=' is not allowed."],
    "stderr_excludes": ["Parser error:"],
    "stdout_excludes": []]
