# STRUCT-111: runtime numeric mismatch
check ["id": "STRUCT-111",
    "name": "runtime numeric mismatch",
    "source": "struct S { n: Number }; let \$n = \"x\"; echo S(n: \$n)",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "(Type error|Unknown field|Cannot access|Cannot assign|For loops require|Cannot execute|Cannot index|Arithmetic error)",
    "stderr_contains": ["Expected Number"],
    "stderr_excludes": ["Parser error:"],
    "stdout_excludes": []]
