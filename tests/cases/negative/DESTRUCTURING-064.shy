# DESTRUCTURING-064: null is an element and cannot be destructured
check ["id": "DESTRUCTURING-064",
    "name": "null is an element and cannot be destructured",
    "source": "for (\$a, \$b) in [()] { echo \"UNREACHABLE\" }",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "Array error:",
    "stderr_contains": ["Array destructuring requires an array"],
    "stderr_excludes": ["Parser error:"],
    "stdout_excludes": []]
