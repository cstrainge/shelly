# MODULE-076: different selected variables collide
let $module_fixture = $args[0]
printf "%s" ("let \$x = 1".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/one.shy"
printf "%s" ("let \$x = 2".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/two.shy"
check [
    "id": "MODULE-076",
    "name": "different selected variables collide",
    "source": "import one::{ \$x }; import two::{ \$x }",
    "mode": "file",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "Module error:",
    "stderr_contains": ["already bound"],
    "stderr_excludes": [],
    "stdout_excludes": []]
