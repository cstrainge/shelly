# ANNOTATION-170: bad reference parameter
check ["id": "ANNOTATION-170",
    "name": "bad reference parameter",
    "source": "fn f(\$x: Number) {}; let \$r = `f; \$r \"bad\"",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "(Type error|Unknown field|Cannot access|Cannot assign|For loops require|Cannot execute|Cannot index|Arithmetic error)",
    "stderr_contains": [],
    "stderr_excludes": ["Parser error:"],
    "stdout_excludes": []]
