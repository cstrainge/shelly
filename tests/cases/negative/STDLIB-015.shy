# STDLIB-015: first standard match is not bypassed on parse error
let $std_fixture = $args[0]
mkdir -p "${std_fixture}/one"
printf "%s" ("let \$".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/one/net.shy"
mkdir -p "${std_fixture}/two"
printf "%s" ("echo wrong".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/two/net.shy"
printf "%s" ("import std::net".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/entry.shy"
check [
    "id": "STDLIB-015",
    "name": "first standard match is not bypassed on parse error",
    "source": "env \"SHELLY_STD_PATH=<FIXTURE>/one:<FIXTURE>/two\" \"SHELLY_MODULE_PATH=<FIXTURE>/lib\" \$shelly -m \"<FIXTURE>/entry.shy\"",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "Parser error:",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
