check ["id": "STRUCT-127",
    "name": "float key not representable",
    "source": "struct S { m: [Float: Number] }; let \$m = [9007199254740993: 1]; echo S(m: \$m)",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "(Type error|Unknown field|Cannot access|Cannot assign|For loops require|Cannot execute|Cannot index|Arithmetic error)",
    "stderr_contains": ["Expected Float"],
    "stderr_excludes": ["Parser error:"],
    "stdout_excludes": []]
