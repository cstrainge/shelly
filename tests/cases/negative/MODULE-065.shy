# MODULE-065: qualified write enforces type
let $module_fixture = $args[0]
printf "%s" ("let \$value: Integer = 7\nfn ping(\$x) { echo \"ping\" \$x \$value }\nfn next() { \$value = \$value + 1; \$value }\nstruct Point { x: Integer }\nenum State { On, Off }\nfn Point::twice(): Integer { \$self.x * 2 }\n".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-065",
    "name": "qualified write enforces type",
    "source": "import foo; \$foo::value = \"bad\"",
    "mode": "file",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "(Type error|Unknown field|Cannot access|Cannot assign|For loops require|Cannot execute|Cannot index|Arithmetic error)",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
