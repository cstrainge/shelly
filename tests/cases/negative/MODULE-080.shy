# MODULE-080: module environment not an exported member
let $module_fixture = $args[0]
printf "%s" ("".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-080",
    "name": "module environment not an exported member",
    "source": "import foo::{ \$HOME }",
    "mode": "file",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "Module error:",
    "stderr_contains": ["has no member"],
    "stderr_excludes": [],
    "stdout_excludes": []]
