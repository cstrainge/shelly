# STDLIB-044: prelude excluded types unavailable
let $std_fixture = $args[0]
mkdir -p "${std_fixture}/std"
printf "%s" ("[when false] { pub struct Hidden {} }".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/std/prelude.shy"
printf "%s" ("let \$x: Hidden = Hidden()".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/entry.shy"
check [
    "id": "STDLIB-044",
    "name": "prelude excluded types unavailable",
    "source": "env \"SHELLY_STD_PATH=<FIXTURE>/std\" \"SHELLY_MODULE_PATH=<FIXTURE>/lib\" \$shelly -m \"<FIXTURE>/entry.shy\"",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "Type error:",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
