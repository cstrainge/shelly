# MODULE-064: invalid module source
let $module_fixture = $args[0]
printf "%s" ("let \$".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-064",
    "name": "invalid module source",
    "source": "import foo",
    "mode": "file",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "Parser error:",
    "stderr_contains": ["foo.shy"],
    "stderr_excludes": [],
    "stdout_excludes": []]
