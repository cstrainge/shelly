let $module_fixture = $args[0]
printf "%s" ("pub import bar".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
printf "%s" ("pub import foo".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/bar.shy"
check [
