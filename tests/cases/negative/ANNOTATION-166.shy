# ANNOTATION-166: bad nominal return
check ["id": "ANNOTATION-166",
    "name": "bad nominal return",
    "source": "struct A {}; struct B {}; fn f(\$x): A { return \$x }; f B()",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "(Type error|Unknown field|Cannot access|Cannot assign|For loops require|Cannot execute|Cannot index|Arithmetic error)",
    "stderr_contains": [],
    "stderr_excludes": ["Parser error:"],
    "stdout_excludes": []]
