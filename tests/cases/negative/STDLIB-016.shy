# STDLIB-016: empty override disables standard search
let $std_fixture = $args[0]
mkdir -p "${std_fixture}/std"
printf "%s" ("let \$value = 7; struct Packet { code: Integer }; enum State { Ready }; fn ping(\$x) { echo \$x \$value }; fn read() { \$value }".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/std/net.shy"
printf "%s" ("import std::net".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/entry.shy"
check [
    "id": "STDLIB-016",
    "name": "empty override disables standard search",
    "source": "env \"SHELLY_STD_PATH=\" \"SHELLY_MODULE_PATH=<FIXTURE>/lib\" \$shelly -m \"<FIXTURE>/entry.shy\"",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "Module error:",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
