# STRUCT-124: not executable reference
check ["id": "STRUCT-124",
    "name": "not executable reference",
    "source": "struct S {}; let \$s = S(); let \$f = `\$s",
    "mode": "code",
    "args": [],
    "stdout": "",
    "status": 1,
    "valid": false,
    "error": "(Type error|Unknown field|Cannot access|Cannot assign|For loops require|Cannot execute|Cannot index|Arithmetic error)",
    "stderr_contains": ["Cannot execute a struct"],
    "stderr_excludes": ["Parser error:"],
    "stdout_excludes": []]
