# MODULE-022: selected names can be reexported
let $module_fixture = $args[0]
printf "%s" ("pub import bar::{ ping }".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
printf "%s" ("pub fn ping() { echo \"nested\" }".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/bar.shy"
check [
    "id": "MODULE-022",
    "name": "selected names can be reexported",
    "source": "import foo::{ ping }; ping",
    "mode": "file",
    "args": [],
    "stdout": "nested\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
