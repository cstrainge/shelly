# STDLIB-041: cached prelude survives file removal
let $std_fixture = $args[0]
mkdir -p "${std_fixture}/std"
printf "%s" ("echo \"prelude\"; pub struct Shared { code: Integer }; pub enum State { Ready }; pub fn Shared::twice(): Integer { \$self.code * 2 }; pub let \$hidden = 7; pub fn hidden(\$x) { echo \$x }; rm \"<FIXTURE>/std/prelude.shy\"".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/std/prelude.shy"
printf "%s" ("pub fn build(): Shared { Shared(code: 3) }".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/one.shy"
printf "%s" ("import one; import std::prelude; echo (one::build)".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/entry.shy"
check [
    "id": "STDLIB-041",
    "name": "cached prelude survives file removal",
    "source": "env \"SHELLY_STD_PATH=<FIXTURE>/std\" \"SHELLY_MODULE_PATH=<FIXTURE>/lib\" \$shelly -m \"<FIXTURE>/entry.shy\"",
    "mode": "code",
    "args": [],
    "stdout": "prelude\nShared(code: 3)\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
