    "name": "ordinary enclosing block still scopes variables",
    "source": "let \$x = 1; { [when true] { let \$x = 2 }; echo \$x }; echo \$x",
    "mode": "code",
    "args": [],
    "stdout": "2\n1\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
