# STDLIB-014: standard lookup continues past missing file
let $std_fixture = $args[0]
mkdir -p "${std_fixture}/two"
printf "%s" ("fn ping(\$x) { echo second \$x }".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/two/net.shy"
printf "%s" ("import std::net; std::net::ping hi".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/entry.shy"
check [
    "id": "STDLIB-014",
    "name": "standard lookup continues past missing file",
    "source": "env \"SHELLY_STD_PATH=<FIXTURE>/one:<FIXTURE>/two\" \"SHELLY_MODULE_PATH=<FIXTURE>/lib\" \$shelly -m \"<FIXTURE>/entry.shy\"",
    "mode": "code",
    "args": [],
    "stdout": "second hi\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
