# MATCH-056: single subject evaluation
check ["id": "MATCH-056",
    "name": "single subject evaluation",
    "source": "let \$calls = 0; fn once() { \$calls = \$calls + 1; 2 }; echo (match (once) { 1 => { 1 } 2 => { 2 } _ => { 3 } }) \$calls",
    "mode": "code",
    "args": [],
    "stdout": "2 1\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
