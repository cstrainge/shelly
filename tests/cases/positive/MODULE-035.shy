# MODULE-035: whole import does not replace local value
let $module_fixture = $args[0]
printf "%s" ("let \$value: Integer = 7\nfn ping(\$x) { echo \"ping\" \$x \$value }\nfn next() { \$value = \$value + 1; \$value }\nstruct Point { x: Integer }\nenum State { On, Off }\nfn Point::twice(): Integer { \$self.x * 2 }\n".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-035",
    "name": "whole import does not replace local value",
    "source": "let \$value = 90; import foo; echo \$value \$foo::value",
    "mode": "file",
    "args": [],
    "stdout": "90 7\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
