# MODULE-021: nested module lookup
let $module_fixture = $args[0]
printf "%s" ("import bar".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
printf "%s" ("fn ping() { echo \"nested\" }; struct S {}".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/bar.shy"
check [
    "id": "MODULE-021",
    "name": "nested module lookup",
    "source": "import foo; foo::bar::ping; echo foo::bar::S()",
    "mode": "file",
    "args": [],
    "stdout": "nested\nS()\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
