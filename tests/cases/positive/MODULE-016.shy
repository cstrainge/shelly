# MODULE-016: module initializes once
let $module_fixture = $args[0]
printf "%s" ("echo \"loaded\"\npub let \$value: Integer = 7\npub fn ping(\$x) { echo \"ping\" \$x \$value }\npub fn next() { \$value = \$value + 1; \$value }\npub struct Point { x: Integer }\npub enum State { On, Off }\npub fn Point::twice(): Integer { \$self.x * 2 }\n".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-016",
    "name": "module initializes once",
    "source": "import foo; import foo::{ next }; import foo; echo (next)",
    "mode": "file",
    "args": [],
    "stdout": "loaded\n8\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
