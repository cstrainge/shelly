# MODULE-043: module path searches in order
let $module_fixture = $args[0]
mkdir -p "${module_fixture}/app"
printf "%s" ("import foo; foo::ping".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/app/main.shy"
mkdir -p "${module_fixture}/first"
printf "%s" ("pub fn ping() { echo \"first\" }".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/first/foo.shy"
mkdir -p "${module_fixture}/second"
printf "%s" ("pub fn ping() { echo \"second\" }".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/second/foo.shy"
check [
    "id": "MODULE-043",
    "name": "module path searches in order",
    "source": "env \"SHELLY_MODULE_PATH=<FIXTURE>/none:<FIXTURE>/first:<FIXTURE>/second\" \$shelly -m \"<FIXTURE>/app/main.shy\"",
    "mode": "code",
    "args": [],
    "stdout": "first\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
