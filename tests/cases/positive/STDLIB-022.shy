# STDLIB-022: standard reexports shared binding
let $std_fixture = $args[0]
mkdir -p "${std_fixture}/std"
printf "%s" ("pub let \$value = 7; pub struct Packet { code: Integer }; pub enum State { Ready }; pub fn ping(\$x) { echo \$x \$value }; pub fn read() { \$value }".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/std/net.shy"
printf "%s" ("pub import std::net::{ \$value }".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/facade.shy"
printf "%s" ("import facade::{ \$value }; import std::net; \$value = 12; echo \$std::net::value".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/entry.shy"
check [
    "id": "STDLIB-022",
    "name": "standard reexports shared binding",
    "source": "env \"SHELLY_STD_PATH=<FIXTURE>/std\" \"SHELLY_MODULE_PATH=<FIXTURE>/lib\" \$shelly -m \"<FIXTURE>/entry.shy\"",
    "mode": "code",
    "args": [],
    "stdout": "12\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
