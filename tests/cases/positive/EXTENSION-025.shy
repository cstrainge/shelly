# EXTENSION-025: nested receiver mutation
check ["id": "EXTENSION-025",
    "name": "nested receiver mutation",
    "source": "struct S { a: [Integer] }; fn S::replace(): S { \$self.a[0] = 9; return \$self }; let \$s = S(a: [1]); let \$t = \$s.replace; echo \$s.a[0] \$t.a[0]",
    "mode": "code",
    "args": [],
    "stdout": "9 9\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
