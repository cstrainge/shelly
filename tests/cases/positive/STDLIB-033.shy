# STDLIB-033: prelude first directory wins
let $std_fixture = $args[0]
mkdir -p "${std_fixture}/one"
printf "%s" ("pub struct First {}".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/one/prelude.shy"
mkdir -p "${std_fixture}/two"
printf "%s" ("echo wrong".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/two/prelude.shy"
printf "%s" ("echo First()".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/entry.shy"
check [
    "id": "STDLIB-033",
    "name": "prelude first directory wins",
    "source": "env \"SHELLY_STD_PATH=<FIXTURE>/one:<FIXTURE>/two\" \"SHELLY_MODULE_PATH=<FIXTURE>/lib\" \$shelly -m \"<FIXTURE>/entry.shy\"",
    "mode": "code",
    "args": [],
    "stdout": "First()\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
