# MODULE-004: selected binding is shared
let $module_fixture = $args[0]
printf "%s" ("let \$value: Integer = 7\nfn ping(\$x) { echo \"ping\" \$x \$value }\nfn next() { \$value = \$value + 1; \$value }\nstruct Point { x: Integer }\nenum State { On, Off }\nfn Point::twice(): Integer { \$self.x * 2 }\n".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-004",
    "name": "selected binding is shared",
    "source": "import foo::{ \$value, next }; \$value = 20; echo \$foo::value (next) \$value",
    "mode": "file",
    "args": [],
    "stdout": "20 21 21\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
