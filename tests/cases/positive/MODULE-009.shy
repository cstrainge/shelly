# MODULE-009: selected type has same identity
let $module_fixture = $args[0]
printf "%s" ("pub let \$value: Integer = 7\npub fn ping(\$x) { echo \"ping\" \$x \$value }\npub fn next() { \$value = \$value + 1; \$value }\npub struct Point { x: Integer }\npub enum State { On, Off }\npub fn Point::twice(): Integer { \$self.x * 2 }\n".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-009",
    "name": "selected type has same identity",
    "source": "import foo::{ Point, State }; let \$p: Point = foo::Point(x: 4); let \$s: State = foo::State::Off; echo (\$p == Point(x: 4)) (\$s == State::Off)",
    "mode": "file",
    "args": [],
    "stdout": "true true\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
