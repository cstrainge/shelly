# MODULE-006: redeclaring selected variable creates local binding
let $module_fixture = $args[0]
printf "%s" ("pub let \$value: Integer = 7\npub fn ping(\$x) { echo \"ping\" \$x \$value }\npub fn next() { \$value = \$value + 1; \$value }\npub struct Point { x: Integer }\npub enum State { On, Off }\npub fn Point::twice(): Integer { \$self.x * 2 }\n".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-006",
    "name": "redeclaring selected variable creates local binding",
    "source": "import foo::{ \$value }; let \$value = 90; echo \$value \$foo::value",
    "mode": "file",
    "args": [],
    "stdout": "90 7\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
