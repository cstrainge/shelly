# CONDLOOP-095: until / probe once per iteration plus final check
check ["id": "CONDLOOP-095",
    "name": "until / probe once per iteration plus final check",
    "source": "let \$n = 0; fn probe() { \$n = \$n + 1; \$n == 3 }; until probe { echo \$n }; echo \$n",
    "mode": "code",
    "args": [],
    "stdout": "1\n2\n3\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
