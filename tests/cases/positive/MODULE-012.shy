# MODULE-012: method on qualified type
let $module_fixture = $args[0]
printf "%s" ("pub let \$value: Integer = 7\npub fn ping(\$x) { echo \"ping\" \$x \$value }\npub fn next() { \$value = \$value + 1; \$value }\npub struct Point { x: Integer }\npub enum State { On, Off }\npub fn Point::twice(): Integer { \$self.x * 2 }\n".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-012",
    "name": "method on qualified type",
    "source": "import foo; fn foo::Point::triple(): Integer { \$self.x * 3 }; let \$p = foo::Point(x: 4); echo \$p.triple",
    "mode": "file",
    "args": [],
    "stdout": "12\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
