# CONTROL-060: continue table / [] / 2
check ["id": "CONTROL-060",
    "name": "continue table / [] / 2",
    "source": "for \$i in [] { if \$i == 2 { continue }; echo \$i }; echo \"done\"",
    "mode": "code",
    "args": [],
    "stdout": "done\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
