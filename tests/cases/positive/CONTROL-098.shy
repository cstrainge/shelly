# CONTROL-098: map continue
check ["id": "CONTROL-098",
    "name": "map continue",
    "source": "let \$sum = 0; for \$k,\$v in [\"a\":1,\"b\":2] { if \$k == \"a\" { continue }; \$sum = \$sum + \$v }; echo \$sum",
