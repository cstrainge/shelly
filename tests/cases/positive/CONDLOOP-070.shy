# CONDLOOP-070: while stdin
check ["id": "CONDLOOP-070",
    "name": "while stdin",
    "source": "let \$n = 0; while \$n != 3 { \$n = \$n + 1 }; echo \$n",
    "mode": "stdin",
    "args": [],
    "stdout": "3\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
