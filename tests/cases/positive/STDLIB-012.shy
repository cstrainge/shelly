# STDLIB-012: ordinary module uses its own search path
let $std_fixture = $args[0]
mkdir -p "${std_fixture}/std"
printf "%s" ("pub let \$value = 7; pub struct Packet { code: Integer }; pub enum State { Ready }; pub fn ping(\$x) { echo \$x \$value }; pub fn read() { \$value }".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/std/net.shy"
mkdir -p "${std_fixture}/lib"
printf "%s" ("pub fn ping(\$x) { echo ordinary \$x }".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/lib/net.shy"
printf "%s" ("import net; net::ping hi".replace "<FIXTURE>" $std_fixture) -> "${std_fixture}/entry.shy"
check [
    "id": "STDLIB-012",
    "name": "ordinary module uses its own search path",
    "source": "env \"SHELLY_STD_PATH=<FIXTURE>/std\" \"SHELLY_MODULE_PATH=<FIXTURE>/lib\" \$shelly -m \"<FIXTURE>/entry.shy\"",
    "mode": "code",
    "args": [],
    "stdout": "ordinary hi\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
