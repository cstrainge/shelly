# CONDLOOP-025: while / break skips next probe
check ["id": "CONDLOOP-025",
    "name": "while / break skips next probe",
    "source": "let \$n = 0; fn probe() { \$n = \$n + 1; true }; while probe { break }; echo \$n",
    "mode": "code",
    "args": [],
    "stdout": "1\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
