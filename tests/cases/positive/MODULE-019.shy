# MODULE-019: module function returns typed object
let $module_fixture = $args[0]
printf "%s" ("let \$value: Integer = 7\nfn ping(\$x) { echo \"ping\" \$x \$value }\nfn next() { \$value = \$value + 1; \$value }\nstruct Point { x: Integer }\nenum State { On, Off }\nfn Point::twice(): Integer { \$self.x * 2 }\nfn make(): Point { Point(x: \$value) }".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-019",
    "name": "module function returns typed object",
    "source": "import foo; let \$p: foo::Point = foo::make; echo \$p.x",
    "mode": "file",
    "args": [],
    "stdout": "7\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
