# MODULE-019: module function returns typed object
let $module_fixture = $args[0]
printf "%s" ("pub let \$value: Integer = 7\npub fn ping(\$x) { echo \"ping\" \$x \$value }\npub fn next() { \$value = \$value + 1; \$value }\npub struct Point { x: Integer }\npub enum State { On, Off }\npub fn Point::twice(): Integer { \$self.x * 2 }\npub fn make(): Point { Point(x: \$value) }".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-019",
    "name": "module function returns typed object",
    "source": "import foo; let \$p: foo::Point = foo::make; echo \$p.x",
    "mode": "file",
    "args": [],
    "stdout": "7\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
