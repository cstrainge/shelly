# MODULE-015: qualified function in argument requires grouping
let $module_fixture = $args[0]
printf "%s" ("let \$value: Integer = 7\nfn ping(\$x) { echo \"ping\" \$x \$value }\nfn next() { \$value = \$value + 1; \$value }\nstruct Point { x: Integer }\nenum State { On, Off }\nfn Point::twice(): Integer { \$self.x * 2 }\n".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-015",
    "name": "qualified function in argument requires grouping",
    "source": "import foo; echo foo::next (foo::next)",
    "mode": "file",
    "args": [],
    "stdout": "foo::next 8\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
