# FOR-011: call iterable evaluated once
check ["id": "FOR-011",
    "name": "call iterable evaluated once",
    "source": "let \$hits = 0; fn make() { \$hits = \$hits + 1; [1,2] }; for \$v in make { echo \$v }; echo \$hits",
    "mode": "code",
    "args": [],
    "stdout": "1\n2\n1\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
