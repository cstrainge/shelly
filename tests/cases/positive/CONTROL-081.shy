# CONTROL-081: continue no stale status
check ["id": "CONTROL-081",
    "name": "continue no stale status",
    "source": "for \$i in [1,2] { if (/usr/bin/false) { echo \"bad\" } else { continue } }; echo \"done\"",
    "mode": "code",
    "args": [],
    "stdout": "done\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
