# REDIRECTION-025: large capture
check ["id": "REDIRECTION-025",
    "name": "large capture",
    "source": "let \$out: String; cat data/megabyte -> \$out; let \$expected: String; cat data/megabyte -> \$expected; echo (\$out == \$expected)",
    "mode": "code",
    "args": [],
    "stdout": "true\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
