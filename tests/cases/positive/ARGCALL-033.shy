# ARGCALL-033: executable script path is passed once
check [
    "id": "ARGCALL-033",
    "name": "executable script path is passed once",
    "source": "printf \"#!/usr/bin/env shelly\\necho once\\n\" -> \"argument-script.shy\"; chmod +x argument-script.shy; \$shelly ./argument-script.shy",
    "mode": "code",
    "args": [],
    "stdout": "once\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
