# MODULE-034: multiline selection and condition
let $module_fixture = $args[0]
printf "%s" ("let \$value: Integer = 7\nfn ping(\$x) { echo \"ping\" \$x \$value }\nfn next() { \$value = \$value + 1; \$value }\nstruct Point { x: Integer }\nenum State { On, Off }\nfn Point::twice(): Integer { \$self.x * 2 }\n".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-034",
    "name": "multiline selection and condition",
    "source": "import foo::{\n ping,\n Point,\n \$value,\n} when true\nping \"list\"; echo Point(x: \$value)",
    "mode": "file",
    "args": [],
    "stdout": "ping list 7\nPoint(x: 7)\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
