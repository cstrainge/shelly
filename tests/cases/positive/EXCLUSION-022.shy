# EXCLUSION-022: module excluded exports are absent from compilation
let $module_fixture = $args[0]
printf "%s" "[when false] fn ping(\$x: Missing) {}; [when true] { let \$value = 7; struct S {}; fn ping() { \$value } }" -> "${module_fixture}/foo.shy"
check [
    "id": "EXCLUSION-022",
    "name": "module excluded exports are absent from compilation",
    "source": "import foo::{ ping, \$value, S }; echo (ping) \$value S()",
    "mode": "file",
    "args": [],
    "stdout": "7 7 S()\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
