# MATCH-049: command status
check ["id": "MATCH-049",
    "name": "command status",
    "source": "echo (match (/usr/bin/false) { ExecResult(1) => { \"yes\" } _ => { \"no\" } })",
    "mode": "code",
    "args": [],
    "stdout": "yes\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
