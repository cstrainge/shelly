# CONDLOOP-108: until / continue in condition
check ["id": "CONDLOOP-108",
    "name": "until / continue in condition",
    "source": "let \$n = 0; until (if \$n == 0 { \$n = 1; continue } else { true }) { echo \"bad\" }; echo \$n",
