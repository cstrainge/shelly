# MODULE-045: exported environment reaches module
let $module_fixture = $args[0]
printf "%s" ("import foo; foo::ping".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/app.shy"
printf "%s" ("pub fn ping() { echo \$MARKER }".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-045",
    "name": "exported environment reaches module",
    "source": "env MARKER=value \$shelly -m \"<FIXTURE>/app.shy\"",
    "mode": "code",
    "args": [],
    "stdout": "value\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
