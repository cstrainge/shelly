# STRUCT-037: function copy mutation
check ["id": "STRUCT-037",
    "name": "function copy mutation",
    "source": "struct S { n: Number, text: String, extra: optional }; fn f(\$s) { \$s.n = 9; return \$s }; let \$s = S(n: 1, text: \"x\"); let \$b = f \$s; echo \$s.n \$b.n",
    "mode": "code",
    "args": [],
    "stdout": "1 9\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
