# ARRAY-120: literal spread snapshot survives later element mutation
check ["id": "ARRAY-120",
    "name": "literal spread snapshot survives later element mutation",
    "source": "let \$a = [1,2]; fn change() { \$a[0] = 9; 3 }; let \$b = [\$a...,change]; echo (\$b == [1,2,3]) \$a[0]",
    "mode": "code",
    "args": [],
    "stdout": "true 9\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
