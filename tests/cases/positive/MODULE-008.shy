# MODULE-008: qualified constructor and annotation
let $module_fixture = $args[0]
printf "%s" ("let \$value: Integer = 7\nfn ping(\$x) { echo \"ping\" \$x \$value }\nfn next() { \$value = \$value + 1; \$value }\nstruct Point { x: Integer }\nenum State { On, Off }\nfn Point::twice(): Integer { \$self.x * 2 }\n".replace "<FIXTURE>" $args[0]) -> "${module_fixture}/foo.shy"
check [
    "id": "MODULE-008",
    "name": "qualified constructor and annotation",
    "source": "import foo; let \$p: foo::Point = foo::Point(x: 4); echo \$p",
    "mode": "file",
    "args": [],
    "stdout": "Point(x: 4)\n",
    "status": 0,
    "valid": true,
    "error": "",
    "stderr_contains": [],
    "stderr_excludes": [],
    "stdout_excludes": []]
