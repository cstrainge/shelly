let $fixture = $args[0]

banner_case $fixture "\x1b[?62;1;4;6;22c" ["--norc"] true true true "<unloaded>"
banner_case $fixture "\x1b[?62;1;2;22c" ["--norc"] true false true ""
banner_case $fixture "\x1b[?62;24c" ["--norc"] true false true ""
banner_case $fixture "\x1b[?4c" ["--norc"] true false true ""
banner_case $fixture "\x1b[?62;;4c" ["--norc"] true false true ""
banner_case $fixture "\x1b[?badc" ["--norc"] true false true ""
banner_case $fixture "" ["--norc"] true false true ""
banner_case $fixture "fragment:" ["--norc"] true true true ""
banner_case $fixture "late:" ["--norc"] true false true ""
let $attributes = "\x1b[?62"
for $index in 0..128 { $attributes = $attributes + ";1" }
banner_case $fixture ($attributes + ";4c") ["--norc"] true true true ""
banner_case $fixture "\x1b[?62;4c" ["--norc", "-m"] false false true ""
banner_case $fixture "\x1b[?62;4c" ["--norc", "-b"] false false false ""
# Input preceding the response must remain available to the prompt.
banner_case $fixture "echo early-input\r\x1b[?62;4c" ["--norc"] true false true "\nearly-input\n"
banner_case $fixture "\x03\x1b[?62;4c" ["--norc"] true false true "Ctrl+C pressed."

printf "%s" 'let $banner = "CUSTOM-BANNER"' -> "${fixture}/banner-init.shy"
banner_case $fixture "\x1b[?62;4c" ["--rcfile",
    "${fixture}/banner-init.shy"] true false false "CUSTOM-BANNER"
printf "%s" 'fn λ() { echo "unicode-input" }' -> "${fixture}/unicode-init.shy"
banner_case $fixture "λ\r\x1b[?62;4c" ["--rcfile",
    "${fixture}/unicode-init.shy"] true false true "\nunicode-input\n"

# Noninteractive source on a TTY still must not probe or print a banner.
let $terminal = open_terminal [`$shelly, "-c", "echo script-only"] [
    "cwd": $fixture, "env": ["HOME": $fixture, "PATH": "/usr/bin:/bin",
        "TERM": "xterm-256color", "COLORTERM": "truecolor"]]
let $raw = ""
for $attempt in 0..20
{
    let $reply = terminal_read $terminal 50
    $raw = $raw + $reply["text"]
    if $reply["eof"] { break }
}
require (!($raw.contains "\x1b[c")) "noninteractive mode queried capabilities"
require (!($raw.contains "\x1bP")) "noninteractive mode printed graphics"
let $stripped = $raw.replace "\r" ""
require ($stripped == "script-only\n") "noninteractive output changed"
let $status = terminal_close $terminal
require ($status["exit_code"] == 0) "noninteractive child failed"
