# Range errors preserve bindings and scopes
check_repl ["id": "R026",
    "name": "Range errors preserve bindings and scopes",
    "steps": [["let \$r = 1..3", "quiet", ""], ["let \$r = 1..=", "error", ""], ["echo \$r...", "output", "1 2"], ["let \$r = 1..\"3\"", "error", ""], ["echo \$r...", "output", "1 2"], ["{ let \$local = ..3; echo \$local... }", "error", ""], ["echo \$local", "error", "not found"], ["\$r", "error", ""], ["echo \$r...", "output", "1 2"], ["let \$r = 3..1; echo !\$r", "output", "true"], ["echo \"before\" \$r... \"after\"", "output", "before after"]],
    "exit": 0]
