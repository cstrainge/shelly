# REPL false-pass controls distinguish diagnostics from echoed command text.
for ($kind, $expected, $output, $passes) in [
    ["output", "42", "input repaint\n42\n$ ", true],
    ["error", "not found", "echo \"not found\"\nnot found\n$ ", false],
    ["output", "42", "\n42\nInterpreter error at <repl>: (1, 1): bad\n$ ", false],
    ["error", "wrong arity", "\nInterpreter error at <repl>: (1, 1): wrong arity\n$ ", true],
    ["error", "wrong arity", "Interpreter error at <repl>: (1, 1): wrong arity\n$ ", true],
    ["quiet", "", "\nInterpreter error at <repl>: (1, 1): bad\n$ ", false],
    ["error", "wrong arity", "\nInterpreter error at <repl>: (1, 1): wrong type\n$ ", false],
    ["error", "wrong arity", "echo \"wrong arity\"\nInterpreter error at <repl>: (1, 1): wrong type\n$ ", false],
    ["quiet", "", "thread main panicked at source.rs", false],
    ["error", "wrong arity", "echo \"Interpreter error at <repl>: (1, 1): wrong arity\"\n$ ", false],
    ["quiet", "", "echo \"Interpreter error at <repl>: (1, 1): wrong arity\"\n$ ", true],
]
{
    require ((repl_matches $kind $expected $output) == $passes) "REPL matcher false pass"
}
