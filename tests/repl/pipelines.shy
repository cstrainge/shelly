let $fixture = $args[0]
printf "%s" "echo diagnostic -> /dev/stderr\nprintf \"a\\\"b\\n\"\n" -> "${fixture}/bad_csv.shy"

check_repl ["id": "PIPELINES", "name": "Pipeline bindings and recovery across submissions", "steps": [
    ["fn increment(\$n: Integer): Integer { \$n + 1 }; let \$out: Integer", "quiet", ""],
    ["7 | increment | \$out; echo \$out", "output", "8"],
    ["echo (\$out | increment \$ | (\$ * 2))", "output", "18"],
    ["let \$rows: [[String]]", "quiet", ""],
    ["printf \"a,b\\nc,d\\n\" csv:| \$rows; echo \$rows.count \$rows[1]...", "output", "2 c d"],
    ["printf \"\" csv:| \$rows; echo \$rows.count", "output", "0"],
    ["echo \$", "error", "Bare $ is only available"],
    ["echo (2 | (\$ + 1))", "output", "3"],
    ["printf invalid json:| \$out", "error", "format 'json'"],
    ["let \$captured = \"old\"", "quiet", ""],
    ["printf \"a\\\"b\\n\" ~-> \$captured csv:| \$rows", "error", "Quote inside"],
    ["echo \$captured.chars.count", "output", "0"],
    ["shelly -m bad_csv.shy ~-> \$captured csv:| \$rows", "error", "Quote inside"],
    ["echo \$captured.trim", "output", "diagnostic"],
    ["echo \$out", "output", "8"],
    ["let \$status = /usr/bin/false | cat; echo \$status", "output", "ExecResult(1)"],
    ["/usr/bin/false | cat", "error", "Executable returned error code: 1"],
    ["7 | increment 1", "error", "must use bare $"],
    ["echo (7 | increment)", "output", "8"],
    ["let \$inputs: [Integer] = [1,2,3,4,5,6,7]; let \$answers: [Integer]", "quiet", ""],
    ["\$inputs | increment | (\$ * 2) | \$answers; echo \$answers...", "output", "4 6 8 10 12 14 16"],
    ["echo \$inputs...", "output", "1 2 3 4 5 6 7"],
    ["[] | increment | \$answers; echo \$answers.count", "output", "0"],
    ["struct Counter { n: Integer }; fn Counter::next_item(): Integer | () { if \$self.n == 0 { return () }; \$self.n = \$self.n - 1; \$self.n }", "quiet", ""],
    ["fn iterate(): [Integer] { let \$items: [Integer]; Counter(n: 2) | \$items; \$items }", "quiet", ""],
    ["fn Counter::next_item(): Integer | () { if \$self.n == 0 { return () }; \$self.n = 0; 42 }", "quiet", ""],
    ["Counter(n: 2) | \$answers; echo \$answers... (iterate)...", "output", "42 1 0"],
    ["echo (7 | ((\$ | (\$ + 1)) + \$))", "output", "15"],
    ["let \$bytes: String; printf hello | cat | \$bytes; echo \$bytes", "output", "hello"],
    ["type wire = String; fn String::from_wire(\$v: Integer): String { \"old\" }; fn wire::from_string(\$v: String): wire { \$v }; let \$wire: wire", "quiet", ""],
    ["fn old(): String { let \$text: String; 7 |:wire cat | \$text; \$text }", "quiet", ""],
    ["fn String::from_wire(\$v: Integer): String { \"new\" }", "quiet", ""],
    ["7 |:wire cat wire:| \$wire; echo \$wire (old)", "output", "new old"],
    ["struct Box { n: Integer }; fn String::from_box(\$v: Box): String { \"old\" }; fn boxed(): String { let \$text: String; Box(n: 7) | cat | \$text; \$text }", "quiet", ""],
    ["fn String::from_box(\$v: Box): String { \"new\" }", "quiet", ""],
    ["Box(n: 7) | cat | \$bytes; echo \$bytes (boxed)", "output", "new old"],
    ["type Count = Integer; fn Count::from_integer(\$n: Integer): Count { \$n + 10 }; struct Reply { n: Count }", "quiet", ""],
    ["fn decoded(): Reply { let \$reply = Reply(n: 0); printf \"{\\\"n\\\":7}\" json:|:Reply \$reply; \$reply }", "quiet", ""],
    ["type Count = String; fn Count::from_integer(\$n: Integer): Count { \"new\" }", "quiet", ""],
    ["echo Integer((decoded).n)", "output", "17"],
], "exit": 0]
