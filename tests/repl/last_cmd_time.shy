# Command timing is shared with prompts and widgets, excluding editor/rendering time.
let $fixture = $args[0]
let $terminal = session $fixture
let _ = drain $terminal
let $reply = submit $terminal 'echo $last_cmd_time ($last_cmd_time.type == String)'
require (repl_matches "output" "0:00 true" $reply["output"]) "initial command time"
let $reply = submit $terminal '$widgets = [fn (): String { $last_cmd_time }]; fn prompt() { echo "time=${last_cmd_time} ${rendered_widgets}" }'
require (repl_matches "output" "time=0:00 [0:00]" $reply["output"]) "quick command timing"
let $reply = submit $terminal 'sleep 1'
require (repl_matches "output" "time=0:01 [0:01]" $reply["output"]) "elapsed command timing"
let $reply = submit $terminal 'echo $last_cmd_time'
require (repl_matches "output" "0:01" $reply["output"]) "command cannot read previous timing"
require ($reply["output"].contains "\ntime=0:00 [0:00]\n") "quick command did not replace timing"
let $reply = submit $terminal 'sleep 1'
let $reply = submit $terminal ''
require (repl_matches "output" "time=0:00 [0:00]" $reply["output"]) "blank input retained timing"
let $reply = submit $terminal 'sleep 1'
let $reply = submit $terminal '   '
require (repl_matches "output" "time=0:00 [0:00]" $reply["output"]) "whitespace input retained timing"
let $reply = submit $terminal 'sleep 1'
terminal_write $terminal "\x03"
let $reply = drain $terminal
require ($reply["output"].contains "\ntime=0:00 [0:00]\n") "cancellation retained timing"
let $reply = submit $terminal 'sleep 1; 1 / 0'
require (repl_matches "error" "by zero" $reply["output"]) "timing probe did not fail"
require ($reply["output"].contains "\ntime=0:01 [0:01]\n") "failed command timing"

let $reply = submit $terminal 'fn prompt() { sleep 1; echo "time=${last_cmd_time} ${rendered_widgets}" }'
require (repl_matches "output" "time=0:00 [0:00]" $reply["output"]) "prompt execution changed timing"
let $reply = submit $terminal '$widgets = [fn (): String { sleep 1; $last_cmd_time }]'
require (repl_matches "output" "time=0:00 [0:00]" $reply["output"]) "widget execution changed timing"
let $reply = submit $terminal 'sleep 1'
require (repl_matches "output" "time=0:01 [0:01]" $reply["output"]) "rendering included in timing"

printf "%s" 'pub fn elapsed_widget(): String { $last_cmd_time }' -> "${fixture}/elapsed.shy"
let $reply = submit $terminal 'fn prompt() { echo "time=${last_cmd_time} ${rendered_widgets}" }; import elapsed::{ elapsed_widget }; $widgets = [`elapsed_widget]'
require (repl_matches "output" "time=0:00 [0:00]" $reply["output"]) "imported widget cannot read timing"
let $reply = submit $terminal 'sleep 1'
require (repl_matches "output" "time=0:01 [0:01]" $reply["output"]) "imported widget timing stale"

let $reply = submit $terminal 'fn prompt() {}'
let $reply = submit $terminal 'sleep 1'
let $reply = submit $terminal ''
let $reply = submit $terminal 'echo $last_cmd_time'
require (repl_matches "output" "0:00" $reply["output"]) "empty prompt retained timing"

terminal_write $terminal "\x04"
let $closed = drain $terminal
let $status = terminal_close $terminal
require ($status["exit_code"] == 0) "command timing session shutdown"
