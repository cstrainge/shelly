check_repl ["id": "EXCLUSION-REPL", "name": "pre-load exclusion state and recovery",
    "steps": [
        ["let \$enabled = true; let \$checks = 0; fn choose(): any { \$checks = \$checks + 1; \$enabled }", "quiet", ""],
        ["[when \$enabled] fn gadget(): any { 7 }; [when \$enabled] { let \$value = 9; struct S { pub x: Integer } }", "quiet", ""],
        ["echo (gadget) \$value S(x: 3)", "output", "7 9 S(x: 3)"],
        ["let \$enabled = false; [when \$enabled] fn old_environment(): any { 5 }", "quiet", ""],
        ["echo (old_environment) \$enabled", "output", "5 false"],
        ["[when \$enabled] fn gadget(): any { 99 }; [when \$enabled] { let \$value = 88 }; echo (gadget) \$value", "output", "7 9"],
        ["[when \$missing] fn gadget(): any { 99 }", "error", "not found"],
        ["echo (gadget) \$value", "output", "7 9"],
        ["[when true] { struct Failed {}; let \$bad: Integer = \"bad\" }", "error", "Type error"],
        ["let \$bad: Failed = Failed()", "error", "Unknown type"],
        ["let \$enabled = true", "quiet", ""],
        ["fn run(): any { [when (choose)] { 12 } }; echo \$checks", "output", "1"],
        ["echo (run) (run) \$checks", "output", "12 12 1"],
        ["let \$enabled = false; fn choose(): any { true }; [when (choose)] fn selected_old_function(): any { 3 }", "quiet", ""],
        ["echo (selected_old_function) \$checks", "output", "3 2"],
        ["[when (choose)] fn selected_new_function(): any { 4 }; echo (selected_new_function)", "output", "4"],
        ["[when false] { [when \$missing] { echo bad } }; echo (gadget)", "output", "7"]
    ], "exit": 0]
