check_repl ["id": "NAMED_TYPES", "name": "Named identity and failed writes", "steps": [
    ["type Count = Integer; let \$old: Count = 7", "quiet", ""],
    ["type Count = String; let \$new: Count = \"seven\"", "quiet", ""],
    ["echo (Integer(\$old)) (String(\$new)) (\$old == \$new)", "output", "7 seven false"],
    ["\$old = 8; echo \$old", "output", "8"],
    ["\$old = \$new", "error", "Expected Count"],
    ["echo \$old", "output", "8"],
    ["type Count = Missing", "error", "Unknown type"],
    ["echo Count(\"ok\")", "output", "ok"],
    ["type Count = Count", "error", "Recursive type definition"],
    ["echo Count(\"still\")", "output", "still"],
    ["type Numbers = [Integer]; let \$n: Numbers = [1,2]; let \$copy = \$n", "quiet", ""],
    ["\$n[0] = true", "error", "Expected Integer"],
    ["echo \$n \$copy", "output", "1:2 1:2"],
    ["let \$next = `\$n.next_item; echo (\$next) \$n \$copy", "output", "1 2 1:2"],
    ["type Int = Integer; fn Integer::increment() { \$self = \$self + 1 }; let \$i: Int = 3; let \$saved = `\$i.increment", "quiet", ""],
    ["\$saved; echo \$i (\$i == Int(4))", "output", "4 true"],
    ["type Key = String; let \$map: [Key: Integer] = [\"x\": 1]", "quiet", ""],
    ["\$map[\"x\"] = 2", "error", "Map keys collide"],
    ["echo \$map[Key(\"x\")] \$map[\"x\"]", "output", "1 ()"],
    ["let \$u: [Float] | [Float, Integer] = [1,2]", "error", "Ambiguous conversion"],
    ["echo recovered", "output", "recovered"],
], "exit": 0]
