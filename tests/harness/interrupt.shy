# Interrupt the actual suite runner while its nested program is frozen.
let $fixture = $args[0]
let $suite = $args[1]
let $root = "${fixture}/interrupt-suite"
mkdir -p "${root}/tests/cases/negative" "${root}/tests/support"
cp -r "${suite}/tests/fixtures" "${root}/tests/fixtures"
cp "${suite}/tests/support/process.shy" "${root}/tests/support/process.shy"
printf "id\tgroup\tname\tfile\nHANG\tnegative\tinterrupt\ttests/cases/negative/HANG.shy\n" -> "${root}/tests/INVENTORY.tsv"
let $source = "let \$stat: String; /proc/self/stat -> \$stat; echo \$pwd (\$stat.split \" \")[0] -> \"${fixture}/ready\"; loop {}"
# Build a Shelly quoted string with explicit escaping.
let $literal = (($source.replace "\\" "\\\\").replace "\"" "\\\"").replace "\$" "\\\$"
printf 'check ["id": "HANG", "name": "interrupt", "source": "%s", "mode": "code", "args": [], "stdout": "", "status": 1, "valid": false, "error": "Array error:", "stderr_contains": [], "stderr_excludes": [], "stdout_excludes": []]\n' $literal -> "${root}/tests/cases/negative/HANG.shy"
let $terminal = open_terminal [`$shelly, "-m", "${suite}/test.shy"] [
    "cwd": $root, "env": ["HOME": "${fixture}/home", "PATH": "/usr/bin:/bin"],
]
let $ready = false
for $attempt in 0..100
{
    if (test -f "${fixture}/ready") { $ready = true; break }
    let $reply = terminal_read $terminal 50
    require (!$reply["eof"]) "suite exited before frozen case started"
}
require $ready "frozen case did not start"
terminal_write $terminal "\x03"
let $eof = false
for $attempt in 0..100
{
    let $reply = terminal_read $terminal 50
    if $reply["eof"] { $eof = true; break }
}
require $eof "Ctrl+C did not stop suite runner"
let $status = terminal_close $terminal
require ($status["signal"] == 2) "suite runner did not terminate on SIGINT"
let $marker: String
"${fixture}/ready" -> $marker
let $fields = $marker.trim.split " "
let $work = $fields[0]
let $pid = $fields[1]
require ($work.starts_with "/tmp/shelly-suite.") "unexpected case directory"
require (Boolean(test -d $work)) "interrupted directory disappeared"
# The detached assertion driver still owns the nested case's three-second deadline.
let $wait = run_process ["/usr/bin/sleep", "4"] [:]
require (!(test -e "/proc/${pid}/stat")) "nested watchdog left frozen child alive"
rm -rf -- $work
