# End-to-end runner controls. Each nested run gets a disposable suite.
let $fixture = $args[0]
let $suite = $args[1]
let $root = "${fixture}/mini-suite"
mkdir -- "${fixture}/abandoned"
printf "untouched" -> "${fixture}/abandoned/marker"
for ($name, $files, $inventory, $passes, $phrase) in [
    ["empty suite", [:], "id\tgroup\tname\tfile\n", false, "0 / 0"],
    ["empty positive output", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tcontrol\ttests/cases/positive/CONTROL.shy\n", true, "1 / 1"],
    ["record ID disagrees with filename", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"OTHER\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tcontrol\ttests/cases/positive/CONTROL.shy\n", false, "case ID does not match filename"],
    ["only negative category", ["tests/cases/negative/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"echo [][0]\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tnegative\tcontrol\ttests/cases/negative/CONTROL.shy\n", true, "1 / 1"],
    ["spaces Unicode in filenames", ["tests/native/déjà vu.shy": "echo \"hello\""], "id\tgroup\tname\tfile\n", true, "1 / 1"],
    ["empty expected is strict", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"echo \\\"unexpected\\\"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tcontrol\ttests/cases/positive/CONTROL.shy\n", false, "stdout differs"],
    ["wrong positive output", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"echo \\\"wrong\\\"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"right\\n\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tcontrol\ttests/cases/positive/CONTROL.shy\n", false, "stdout differs"],
    ["positive failure", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"echo \\\$absent\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tcontrol\ttests/cases/positive/CONTROL.shy\n", false, "wrong exit status"],
    ["unexpected negative success", ["tests/cases/negative/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"echo \\\"ok\\\"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"ok\\n\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tnegative\tcontrol\ttests/cases/negative/CONTROL.shy\n", false, "wrong exit status"],
    ["plain exit is not language error", ["tests/cases/negative/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"exit 1\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tnegative\tcontrol\ttests/cases/negative/CONTROL.shy\n", false, "wrong error category"],
    ["wrong error rejected", ["tests/cases/negative/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"echo 1 / 0\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tnegative\tcontrol\ttests/cases/negative/CONTROL.shy\n", false, "wrong error category"],
    ["negative wrong exit status", ["tests/cases/negative/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"exit 7\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tnegative\tcontrol\ttests/cases/negative/CONTROL.shy\n", false, "wrong exit status"],
    ["negative missing diagnostic rejected", ["tests/cases/negative/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"echo \\\$absent\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tnegative\tcontrol\ttests/cases/negative/CONTROL.shy\n", false, "known diagnostic"],
    ["panic-like stdout remains text", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"echo \\\"panicked at fake.rs\\\"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"panicked at fake.rs\\n\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tcontrol\ttests/cases/positive/CONTROL.shy\n", true, ""],
    ["missing expected field", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tcontrol\ttests/cases/positive/CONTROL.shy\n", false, ""],
    ["orphan inventory entry", [:], "id\tgroup\tname\tfile\nCONTROL\tpositive\torphan\ttests/cases/positive/CONTROL.shy\n", false, "missing or orphan"],
    ["equal counts wrong names", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nOTHER\tpositive\twrong\ttests/cases/positive/OTHER.shy\n", false, "missing or orphan"],
    ["invalid UTF8 compared safely", ["tests/native/binary.shy": "let \$fixture = \$args[0]\nlet \$r = run_process [\"cat\", \"\${fixture}/data/invalid-utf8\"] [\"stdout_file\": \"\${fixture}/binary\"]\nrequire (\$r[\"exit_code\"] == 0) \"binary producer\"\nrequire (Boolean(cmp -s \"\${fixture}/binary\" \"\${fixture}/data/invalid-utf8\")) \"binary comparison\"\n"], "id\tgroup\tname\tfile\n", true, ""],
    ["stderr is checked separately", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"audit_streams \\\"\\\" \\\"stderr\\\" \\\"0\\\"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [\"stderr\"], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tcontrol\ttests/cases/positive/CONTROL.shy\n", true, ""],
    ["continue after mismatch", ["tests/cases/positive/A_BAD.shy": "check [\"id\": \"A_BAD\", \"name\": \"control\", \"source\": \"echo \\\"wrong\\\"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"expected\\n\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n", "tests/cases/positive/Z_GOOD.shy": "check [\"id\": \"Z_GOOD\", \"name\": \"control\", \"source\": \"echo \\\"good\\\"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"good\\n\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nA_BAD\tpositive\tcontrol\ttests/cases/positive/A_BAD.shy\nZ_GOOD\tpositive\tcontrol\ttests/cases/positive/Z_GOOD.shy\n", false, "1 / 2"],
    ["filesystem HOME and environment isolation", ["tests/native/A.shy": "let \$fixture = \$args[0]\nrequire (!(test -e \"\${fixture}/marker\")) \"fixture leaked\"\nrequire (Boolean(test -d \$HOME)) \"HOME missing\"\nrequire (Boolean(test -d \$TMPDIR)) \"TMPDIR missing\"\nlet \$result = run_process [\"/usr/bin/printenv\", \"SHELLY_TEST_ENV_LEAK\"] [\"stdout_file\": \"\${fixture}/env\"]\nrequire (\$result[\"exit_code\"] == 1) \"environment leaked\"\ntouch \"\${fixture}/marker\" \"\${HOME}/marker\"\nlet \$fixture_text: String\n\"\${fixture}/fixtures/a.txt\" -> \$fixture_text\nrequire (\$fixture_text == \"fixture\\n\") \"fixture mutation leaked\"\nprintf \"changed\" -> \"\${fixture}/fixtures/a.txt\"\n", "tests/native/B.shy": "let \$fixture = \$args[0]\nrequire (!(test -e \"\${fixture}/marker\")) \"fixture leaked\"\nrequire (Boolean(test -d \$HOME)) \"HOME missing\"\nrequire (Boolean(test -d \$TMPDIR)) \"TMPDIR missing\"\nlet \$result = run_process [\"/usr/bin/printenv\", \"SHELLY_TEST_ENV_LEAK\"] [\"stdout_file\": \"\${fixture}/env\"]\nrequire (\$result[\"exit_code\"] == 1) \"environment leaked\"\ntouch \"\${fixture}/marker\" \"\${HOME}/marker\"\nlet \$fixture_text: String\n\"\${fixture}/fixtures/a.txt\" -> \$fixture_text\nrequire (\$fixture_text == \"fixture\\n\") \"fixture mutation leaked\"\nprintf \"changed\" -> \"\${fixture}/fixtures/a.txt\"\n"], "id\tgroup\tname\tfile\n", true, "2 / 2"],
    ["host panic status rejected", ["tests/cases/negative/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"exit 101\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tnegative\tcontrol\ttests/cases/negative/CONTROL.shy\n", false, "wrong exit status"],
    ["host signal rejected", ["tests/cases/negative/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"let \\\$stat: String; /proc/self/stat -> \\\$stat; let \\\$pid = (\\\$stat.split \\\" \\\")[0]; /bin/kill -TERM \\\$pid\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tnegative\tcontrol\ttests/cases/negative/CONTROL.shy\n", false, "terminated by signal"],
    ["loop deadline rejects frozen case", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"loop {}\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tcontrol\ttests/cases/positive/CONTROL.shy\n", false, "timed out"],
    ["later suite ignores abandoned directory", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"echo \\\"next\\\"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"next\\n\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tcontrol\ttests/cases/positive/CONTROL.shy\n", true, "1 / 1"],
    ["duplicate IDs fail", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\nCONTROL\tpositive\tone\ttests/cases/positive/CONTROL.shy\nCONTROL\tpositive\ttwo\ttests/cases/positive/CONTROL.shy\n", false, "duplicate ID"],
    ["path traversal rejected", ["tests/cases/positive/CONTROL.shy": "check [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]\n"], "id\tgroup\tname\tfile\n../CONTROL\tpositive\tx\ttests/cases/positive/CONTROL.shy\n", false, "invalid ID"]
]
{
    let $removed = rm -rf -- $root
    mkdir -p -- "${root}/tests/cases/positive" "${root}/tests/cases/negative" "${root}/tests/native" "${root}/tests/support"
    cp -r -- "${suite}/tests/fixtures" "${root}/tests/fixtures"
    cp -- "${suite}/tests/support/process.shy" "${root}/tests/support/process.shy"
    printf "%s" $inventory -> "${root}/tests/INVENTORY.tsv"
    for $path, $contents in $files { printf "%s" $contents -> "${root}/${path}" }
    let $result = run_process [`$shelly, "-m", "${suite}/test.shy"] [
        "cwd": $root, "env": ["HOME": "${fixture}/home", "PATH": "/usr/bin:/bin", "SHELLY_TEST_ENV_LEAK": "must-not-reach-tests"],
        "timeout_ms": 15000, "stdout_file": "${fixture}/runner.out", "stderr_file": "${fixture}/runner.err",
    ]
    let $out: String
    let $err: String
    "${fixture}/runner.out" -> $out
    "${fixture}/runner.err" -> $err
    if ($result["exit_code"] != (if $passes { 0 } else { 1 })) || ($err != "") || (!($out.contains $phrase))
    {
        echo $name $result $out $err
        fail "runner accepted bad evidence or rejected good evidence"
    }
}
let $marker: String
"${fixture}/abandoned/marker" -> $marker
require ($marker == "untouched") "abandoned files modified"
