
struct InventoryRow
{
    pub id: String,
    pub group: String,
    pub name: String,
    pub file: String
}

let $suite = $args[1]
let $rows: [InventoryRow]

cat "${suite}/tests/INVENTORY.tsv" tsv:|:InventoryRow $rows

require ($rows.count == 4319) "unexpected process case count"

let $seen = [:]

for $row in $rows
{
    require ($seen[$row.id] == ()) "duplicate test ID"
    $seen[$row.id] = true
    require (file_exists "${suite}/${row.file}") "missing case file"
}
