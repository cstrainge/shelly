# Original harness result and schema controls, exercised through the production library.
let $fixture = $args[0]
let $suite = $args[1]
let $library: String
"${suite}/tests/support/process.shy" -> $library
for ($name, $source, $passes) in [
    ["positive control", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []] [\"exit_code\": 0, \"signal\": (), \"timed_out\": false, \"error\": ()] \"\" \"\" \$args[0]", true],
    ["empty stdout is checked", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []] [\"exit_code\": 0, \"signal\": (), \"timed_out\": false, \"error\": ()] \"unexpected\\n\" \"\" \$args[0]", false],
    ["extra positive stderr fails", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []] [\"exit_code\": 0, \"signal\": (), \"timed_out\": false, \"error\": ()] \"\" \"unexpected\" \$args[0]", false],
    ["wrong positive status fails", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []] [\"exit_code\": 1, \"signal\": (), \"timed_out\": false, \"error\": ()] \"\" \"\" \$args[0]", false],
    ["negative control", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []] [\"exit_code\": 1, \"signal\": (), \"timed_out\": false, \"error\": ()] \"\" \"Error: Interpreter error at input: Array error: index out of bounds.\" \$args[0]", true],
    ["unexpected success is not negative pass", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []] [\"exit_code\": 0, \"signal\": (), \"timed_out\": false, \"error\": ()] \"\" \"Error: Interpreter error at input: Array error: index out of bounds.\" \$args[0]", false],
    ["wrong rejection category fails", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []] [\"exit_code\": 1, \"signal\": (), \"timed_out\": false, \"error\": ()] \"\" \"Executable not found: command\" \$args[0]", false],
    ["parse error cannot replace runtime rejection", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []] [\"exit_code\": 1, \"signal\": (), \"timed_out\": false, \"error\": ()] \"\" \"Parser error: Error: Interpreter error at input: Array error: index out of bounds.\" \$args[0]", false],
    ["negative side effects are checked", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []] [\"exit_code\": 1, \"signal\": (), \"timed_out\": false, \"error\": ()] \"AFTER_ERROR\\n\" \"Error: Interpreter error at input: Array error: index out of bounds.\" \$args[0]", false],
    ["panic cannot replace language error", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []] [\"exit_code\": 1, \"signal\": (), \"timed_out\": false, \"error\": ()] \"\" \"Error: Interpreter error at input: Array error: index out of bounds. panicked at source.rs:1\" \$args[0]", false],
    ["stack overflow cannot replace language error", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []] [\"exit_code\": 1, \"signal\": (), \"timed_out\": false, \"error\": ()] \"\" \"Error: Interpreter error at input: Array error: index out of bounds. stack overflow\" \$args[0]", false],
    ["signal cannot replace language error", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []] [\"exit_code\": (), \"signal\": 9, \"timed_out\": false, \"error\": ()] \"\" \"Error: Interpreter error at input: Array error: index out of bounds.\" \$args[0]", false],
    ["timeout cannot replace language error", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []] [\"exit_code\": 1, \"signal\": (), \"timed_out\": true, \"error\": ()] \"\" \"Error: Interpreter error at input: Array error: index out of bounds.\" \$args[0]", false],
    ["specific diagnostic required", "assess [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [\"specific detail\"], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []] [\"exit_code\": 1, \"signal\": (), \"timed_out\": false, \"error\": ()] \"\" \"Error: Interpreter error at input: Array error: index out of bounds.\" \$args[0]", false],
    ["empty catalogs fail", "validate_catalog []", false],
    ["duplicate IDs fail", "validate_catalog [[\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []], [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []]]", false],
    ["missing diagnostic", "validate_case [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": (), \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []]", false],
    ["unknown diagnostic", "validate_case [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"unknown\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []]", false],
    ["wrong negative status", "validate_case [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 7, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []]", false],
    ["unknown input mode", "validate_case [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"typo\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []]", false],
    ["path traversal ID", "validate_case [\"id\": \"../escape\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []]", false],
    ["nontext expected output", "validate_case [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": (), \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []]", false],
    ["ambiguous validity", "validate_case [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": \"false\", \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []]", false],
    ["invalid arguments", "validate_case [\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": \"argument\", \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []]", false],
    ["complete schema control", "validate_catalog [[\"id\": \"CONTROL\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 0, \"valid\": true, \"error\": \"\", \"stderr_contains\": [], \"stderr_excludes\": [], \"stdout_excludes\": []], [\"id\": \"NEGATIVE\", \"name\": \"control\", \"source\": \"\", \"mode\": \"code\", \"args\": [], \"stdout\": \"\", \"status\": 1, \"valid\": false, \"error\": \"Array error:\", \"stderr_contains\": [], \"stderr_excludes\": [\"Parser error:\"], \"stdout_excludes\": []]]", true]
]
{
    printf "%s\n%s" $library $source -> "${fixture}/control.shy"
    let $result = run_process [`$shelly, "-m", "${fixture}/control.shy", $fixture] [
        "timeout_ms": 2000, "stdout_file": "${fixture}/control.out", "stderr_file": "${fixture}/control.err",
    ]
    require (($result["signal"] == ()) && (!$result["timed_out"]) && ($result["error"] == ())) $name
    require ($result["exit_code"] == (if $passes { 0 } else { 1 })) $name
}
