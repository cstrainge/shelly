#!/usr/bin/env shelly


fn run_test($test_file: String, $output_file: String, $expect_success: Boolean): Boolean
{
    let $test_name: String
    let $output_name: String

    basename -- $test_file .shy ~+-> $test_name
    basename -- $output_file .txt ~+-> $output_name

    if $test_name != $output_name
    {
        echo "$test_file has no matching expected output file; found $output_file."
        return false
    }

    let $expected_output: String
    $output_file -> $expected_output

    let $output: String
    let $result = $shelly $test_file ~+-> $output
    let $succeeded: Boolean = !!$result

    if $succeeded != $expect_success
    {
        if $expect_success
        {
            echo "$test_file failed (result: $result)."
        }
        else
        {
            echo "$test_file unexpectedly succeeded."
        }

        return false
    }

    # An empty expected-output file disables output comparison.
    if    ($expected_output != "")
       && ($output != $expected_output)
    {
        echo "$test_file produced unexpected output."
        return false
    }

    true
}


let $must_succeed    = (./tests/must_succeed/*.shy).sort
let $succeed_outputs = (./tests/must_succeed/*.txt).sort

let $must_fail       = (./tests/must_fail/*.shy).sort
let $fail_outputs    = (./tests/must_fail/*.txt).sort


if    ($must_succeed.count != $succeed_outputs.count)
   || ($must_fail.count != $fail_outputs.count)
{
    echo "* Missing expected output files for tests. Each test must have an expected output .txt
            If the output doesn't matter include an empty .txt file for that test.
          *"
    exit 1
}


let $total_succeed = $must_succeed.count
let $total_fail    = $must_fail.count

let $total = $total_succeed + $total_fail


echo "*
        Shelly Test Suite

        About to run $total tests.

            $total_succeed positive tests.
            $total_fail negative tests.

      *"


let $success_count = 0

for ($test_file, $output_file) in $must_succeed.map $succeed_outputs
{
    if (run_test $test_file $output_file true)
    {
        $success_count = $success_count + 1
    }
}

for ($test_file, $output_file) in $must_fail.map $fail_outputs
{
    if (run_test $test_file $output_file false)
    {
        $success_count = $success_count + 1
    }
}


echo ${success_count} '/' ${total} tests passed.


if $success_count != $total
{
    exit 1
}
