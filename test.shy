#!/usr/bin/env shelly


let $must_succeed    = (./tests/must_succeed/*.shy).sort
let $succeed_outputs = (./tests/must_succeed/*.txt).sort

let $must_fail       = (./tests/must_fail/*.shy).sort
let $fail_outputs    = (./tests/must_fail/*.txt).sort


if    ($must_succeed != $succeed_outputs)
   || ($must_fail != $fail_outputs)
{
    echo "* Missing expected output files for tests. Each test must have an expected output .txt
            If the output doesn't matter include an empty .txt file for that test.
          *"
}


let $total_succeed = $must_succeed.count
let $total_fail    = $must_fail.count

let $total = $total_succeed + $total_fail


echo "*
        Shelly Test Suite

        About to run $total tests.

            $total_succeed positive tests.
            $total_fail negative tests.

      *"


let $success_count = 0

for ($test_file, $output_file) in $must_succeed.map($succeed_outputs)
{
    let $output
    let $result = $test_file ~+-> $output
    let $expected_output

    $output_file -> $output

    if    $result
       && ($output == $expected_output)
    {
        $success_count = $success_count + 1
    }
    else
    {
        echo "$file failed."
    }
}

for $file in $must_fail
{
    let $output
    let $result = $test_file ~+-> $output
    let $expected_output

    $output_file -> $output

    if    ! $result
       && ($output == $expected_output)
    {
        $success_count = $success_count + 1
    }
    else
    {
        echo "$file unexpectedly succeeded."
    }
}



echo ${success_count} '/' ${total} tests passed.


if ($total - $success_count) != 0
{
    exit 1
}
