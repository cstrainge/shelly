# Responses client. The model remains a caller choice; no live requests occur on import.
import std::io
import std::json
import std::stream
import std::net::http
import std::net::sse

pub enum Role { Developer, User, Assistant }

pub fn Role::json_codec(): std::json::Codec
{
    std::json::enum_codec Role [
        Role::Developer: "developer",
        Role::User: "user",
        Role::Assistant: "assistant",
    ]
}

pub struct Message
{
    pub role: Role,
    pub content: String,
}

pub struct Request
{
    pub model: String,
    pub input: String | [Message],
    pub instructions: optional String,
    pub max_output_tokens: optional Integer,
    pub store: optional Boolean,
}

pub fn Request::json_codec(): std::json::Codec
{
    std::json::struct_codec Request std::json::StructOptions(
        omit_null_fields: ["instructions", "max_output_tokens", "store"],
    )
}

pub struct Usage
{
    pub input_tokens: Integer,
    pub output_tokens: Integer,
    pub total_tokens: Integer,
}

struct Envelope
{
    pub id: String,
    pub status: String,
    pub usage: optional Usage,
}

pub struct Response
{
    pub id: String,
    pub status: String,
    pub usage: optional Usage,
    pub request_id: optional String,
    pub raw: std::json::Document,
}

pub fn Response::from_json($document: std::json::Document): Response | std::json::Error
{
    let $envelope: Envelope = std::json::convert $document Envelope (std::json::MappingOptions(unknown_fields: std::json::UnknownFields::Ignore))

    Response(
        id: $envelope.id,
        status: $envelope.status,
        usage: $envelope.usage,
        raw: $document,
    )
}

pub fn Response::to_json(): std::json::Document
{
    $self.raw
}

pub enum ResponseFailure { Incomplete, Failed, Refused, NoText, Protocol, Truncated }

pub error struct ApiError
{
    pub status: Integer,
    pub message: String,
    pub request_id: optional String,
    pub response: std::json::Document,
}

pub error struct ResponseError
{
    pub what: ResponseFailure,
    pub message: String,
    pub request_id: optional String,
    pub response: optional std::json::Document,
}

pub type Error = ApiError | ResponseError | std::net::http::Error | std::json::Error | std::net::sse::Error | std::stream::Error

pub fn String::from_apierror($error: ApiError): String
{
    "OpenAI HTTP ${error.status}: ${error.message}"
}

pub fn String::from_responseerror($error: ResponseError): String
{
    "OpenAI ${error.what}: ${error.message}"
}

# Return the marked value to transfer it to the caller's success-only context.
fn response_failure($what: ResponseFailure, $message: String,
                    $request_id: optional String,
                    $document: optional std::json::Document): ResponseError
{
    ResponseError(
        what: $what,
        message: $message,
        request_id: $request_id,
        response: $document,
    )
}

pub fn Response::require_text(): String | ResponseError | std::json::Error
{
    if $self.status != "completed"
    {
        let $what = if $self.status == "incomplete"
            { ResponseFailure::Incomplete }
            else { ResponseFailure::Failed }

        return (response_failure $what "Response did not complete" $self.request_id $self.raw)
    }

    let $text = ""
    for $item in $self.raw.array_items "/output"
    {
        if ($item.require_string "/type") != "message" { continue }

        for $part in $item.array_items "/content"
        {
            match ($part.require_string "/type")
            {
                "output_text" => { $text = $text + ($part.require_string "/text") },
                "refusal" =>
                {
                    return (response_failure ResponseFailure::Refused ($part.require_string "/refusal") $self.request_id $self.raw)
                },
                _ => {},
            }
        }
    }

    if $text == ""
    {
        return (response_failure ResponseFailure::NoText "Response contains no text output" $self.request_id $self.raw)
    }

    $text
}

fn ApiError::from_statuserror($error: std::net::http::StatusError): ApiError | std::json::Error | std::net::http::Error
{
    let $reply = $error.response
    let $document = $reply.read_document

    ApiError(
        status: $reply.status,
        message: ($document.require_string "/error/message"),
        request_id: ($reply.headers.get "x-request-id"),
        response: $document,
    )
}

pub struct Client
{
    transport: std::net::http::Client,
    model: String,
}

pub fn Client::new($api_key: String, $model: String, $base_url: optional String): Client | Error
{
    Client(
        transport: std::net::http::Client(
            base_url: (if $base_url == () { "https://api.openai.com/v1/" } else { $base_url }),
            auth: (std::net::http::bearer $api_key),
            timeout_ms: 120000,
            error_decoder: ApiError,
        ),
        model: $model,
    )
}

pub fn Client::create($request: Request): Response | Error
{
    let $reply: std::net::http::Response = $self.::transport.post "responses" (std::net::http::json_body $request)

    let $response: Response = $reply.require_success.read_as Response
    $response.request_id = $reply.headers.get "x-request-id"
    $response
}

pub fn Client::text($input: String, $instructions: optional String): String | Error
{
    let $response: Response = $self.create Request(
        model: $self.::model,
        input: $input,
        instructions: $instructions,
        store: false,
    )

    $response.require_text
}

pub fn Client::close()
{
    $self.::transport.close
}

pub struct Event
{
    pub kind: String,
    pub sequence: Integer,
    pub raw: std::json::Document,
}
pub fn Event::from_json($document: std::json::Document): Event | std::json::Error
{
    Event(kind: ($document.require_string "/type"),
        sequence: ($document.require_integer "/sequence_number"), raw: $document)
}

struct TextSession
{
    request_id: optional String,
    response_id: String,
    sequence: Integer,
    count: Integer,
    bytes: Integer,
    items: [Integer: std::json::Document],
    done_items: [Integer: Boolean],
    channel: Boolean,
    item_id: String,
    output_index: Integer,
    content_index: Integer,
    text: String,
    text_done: Boolean,
    part_done: Boolean,
    item_done: Boolean,
    completed: optional Response,
}
fn TextSession::new($request_id: optional String): TextSession
{
    TextSession(request_id: $request_id, response_id: "", sequence: -1, count: 0, bytes: 0,
        items: [:], done_items: [:], channel: false, item_id: "", output_index: -1, content_index: -1,
        text: "", text_done: false, part_done: false, item_done: false)
}
fn TextSession::failure($what: ResponseFailure, $message: String,
                        $evidence: optional std::json::Document): ResponseError
{
    response_failure $what $message $self.::request_id $evidence
}
fn TextSession::check_tuple($event: std::json::Document): () | Error
{
    if !$self.::channel ||
        ($event.require_string "/item_id") != $self.::item_id ||
        ($event.require_integer "/output_index") != $self.::output_index ||
        ($event.require_integer "/content_index") != $self.::content_index
    { return ($self.failure ResponseFailure::Protocol "Text channel does not match" $event) }
}
fn TextSession::accept($event: Event): optional String | Error
{
    let $doc = $event.raw
    $self.::count = $self.::count + 1
    $self.::bytes = $self.::bytes + std::io::Bytes(std::json::encode $doc).count
    if ($self.::count > 32768) || ($self.::bytes > 67108864)
    { return ($self.failure ResponseFailure::Protocol "Stream exceeds event budget" $doc) }
    if ($event.sequence < 0) || ($event.sequence <= $self.::sequence)
    { return ($self.failure ResponseFailure::Protocol "Event sequence is not increasing" $doc) }
    $self.::sequence = $event.sequence
    let $response = $doc.find "/response"
    if $event.kind == "response.created"
    {
        let $id = $doc.require_string "/response/id"
        if ($self.::response_id != "") || ($id == "")
        { return ($self.failure ResponseFailure::Protocol "Invalid response creation" $doc) }
        $self.::response_id = $id
        return ()
    }
    if $event.kind == "error"
    { return ($self.failure ResponseFailure::Failed ($doc.require_string "/message") $doc) }
    if $self.::response_id == ""
    { return ($self.failure ResponseFailure::Protocol "Event precedes response creation" $doc) }
    if $response != () && ($response.require_string "/id") != $self.::response_id
    { return ($self.failure ResponseFailure::Protocol "Response ID changed" $doc) }
    match $event.kind
    {
        "response.output_item.added" =>
            {
                let $index = $doc.require_integer "/output_index"
                let $item = $doc.at "/item"
                let $id = $item.require_string "/id"
                if ($index < 0) || ($id == "") || ($self.::items.count >= 256) ||
                    ($self.::items[$index] != ())
                { return ($self.failure ResponseFailure::Protocol "Invalid output item registration" $doc) }
                for (_, $existing) in $self.::items
                {
                    if ($existing.require_string "/id") == $id
                    { return ($self.failure ResponseFailure::Protocol "Duplicate output item ID" $doc) }
                }
                $self.::items[$index] = $item
            },
        "response.content_part.added" =>
            {
                let $index = $doc.require_integer "/output_index"
                let $content = $doc.require_integer "/content_index"
                let $id = $doc.require_string "/item_id"
                let $item = $self.::items[$index]
                if ($index < 0) || ($content < 0) || ($item == ()) || $self.::done_items[$index] == true ||
                    ($item.require_string "/id") != $id
                { return ($self.failure ResponseFailure::Protocol "Invalid content part identity" $doc) }
                if ($doc.require_string "/part/type") != "output_text" { return () }
                if $self.::channel || ($index < 0) || ($content < 0) || ($item == ())
                { return ($self.failure ResponseFailure::Protocol "Invalid text channel registration" $doc) }
                if ($item.require_string "/id") != $id ||
                    ($item.require_string "/type") != "message" ||
                    ($doc.require_string "/part/text") != ""
                { return ($self.failure ResponseFailure::Protocol "Invalid initial text part" $doc) }
                $self.::channel = true
                $self.::item_id = $id
                $self.::output_index = $index
                $self.::content_index = $content
            },
        "response.output_text.delta" =>
            {
                $self.check_tuple $doc
                if $self.::text_done
                { return ($self.failure ResponseFailure::Protocol "Delta follows text completion" $doc) }
                let $delta = $doc.require_string "/delta"
                if std::io::Bytes($self.::text).count + std::io::Bytes($delta).count > 1048576
                { return ($self.failure ResponseFailure::Protocol "Text exceeds 1 MiB" $doc) }
                $self.::text = $self.::text + $delta
                return $delta
            },
        "response.output_text.done" =>
            {
                $self.check_tuple $doc
                if $self.::text_done || ($doc.require_string "/text") != $self.::text
                { return ($self.failure ResponseFailure::Protocol "Final text differs from deltas" $doc) }
                $self.::text_done = true
            },
        "response.content_part.done" =>
            {
                if ($doc.require_string "/part/type") != "output_text" { return () }
                $self.check_tuple $doc
                if !$self.::text_done || $self.::part_done ||
                    ($doc.require_string "/part/text") != $self.::text
                { return ($self.failure ResponseFailure::Protocol "Text part completion is inconsistent" $doc) }
                $self.::part_done = true
            },
        "response.output_item.done" =>
            {
                let $index = $doc.require_integer "/output_index"
                let $item = $self.::items[$index]
                if ($index < 0) || ($item == ()) || $self.::done_items[$index] == true
                { return ($self.failure ResponseFailure::Protocol "Invalid output item completion" $doc) }
                if ($doc.require_string "/item/id") != ($item.require_string "/id") ||
                    ($doc.require_string "/item/type") != ($item.require_string "/type")
                { return ($self.failure ResponseFailure::Protocol "Output item identity changed" $doc) }
                $self.::done_items[$index] = true
                if $index == $self.::output_index
                {
                    if !$self.::part_done || $self.::item_done ||
                        ($doc.require_string "/item/id") != $self.::item_id ||
                        ($doc.require_string "/item/type") != "message"
                    { return ($self.failure ResponseFailure::Protocol "Output item completion is inconsistent" $doc) }
                    let $parts = ($doc.at "/item").array_items "/content"
                    if $self.::content_index >= $parts.count ||
                        ($parts[$self.::content_index].require_string "/type") != "output_text" ||
                        ($parts[$self.::content_index].require_string "/text") != $self.::text
                    { return ($self.failure ResponseFailure::Protocol "Completed item differs from deltas" $doc) }
                    $self.::item_done = true
                }
            },
        "response.completed" =>
            {
                if ($response.require_string "/status") != "completed" ||
                    !$self.::channel || !$self.::item_done
                { return ($self.failure ResponseFailure::Protocol "Premature or inconsistent completion" $doc) }
                let $items = $response.array_items "/output"
                if $self.::output_index >= $items.count
                { return ($self.failure ResponseFailure::Protocol "Terminal output index changed" $doc) }
                let $item = $items[$self.::output_index]
                if ($item.require_string "/id") != $self.::item_id || ($item.require_string "/type") != "message"
                { return ($self.failure ResponseFailure::Protocol "Terminal item identity changed" $doc) }
                let $parts = $item.array_items "/content"
                if $self.::content_index >= $parts.count ||
                    ($parts[$self.::content_index].require_string "/type") != "output_text" ||
                    ($parts[$self.::content_index].require_string "/text") != $self.::text
                { return ($self.failure ResponseFailure::Protocol "Terminal content channel changed" $doc) }
                let $completed: Response = std::json::convert $response Response
                $completed.request_id = $self.::request_id
                if $completed.require_text != $self.::text
                { return ($self.failure ResponseFailure::Protocol "Completed response differs from emitted text" $doc) }
                $self.::completed = $completed
            },
        "response.failed" =>
            {
                if ($response.require_string "/status") != "failed"
                { return ($self.failure ResponseFailure::Protocol "Failed event has inconsistent status" $doc) }
                return ($self.failure ResponseFailure::Failed "Generation failed" $response)
            },
        "response.incomplete" =>
            {
                if ($response.require_string "/status") != "incomplete"
                { return ($self.failure ResponseFailure::Protocol "Incomplete event has inconsistent status" $doc) }
                return ($self.failure ResponseFailure::Incomplete "Generation is incomplete" $response)
            },
        _ => {},
    }
    ()
}
fn TextSession::next($events: std::stream::Reader): optional String | Error
{
    if $self.::completed != () { return () }
    loop
    {
        let $event = $events.next_item
        if $event == ()
        { return ($self.failure ResponseFailure::Truncated "Stream ended before completion" ()) }
        let $delta = $self.accept $event
        if $delta != () { return $delta }
        if $self.::completed != () { return () }
    }
}
fn TextSession::result(): Response | Error
{
    if $self.::completed == ()
    { return ($self.failure ResponseFailure::Protocol "Stream has not completed" ()) }
    $self.::completed
}

# Useful for scripted transports and deterministic tests as well as HTTP.
pub fn text_stream($events: std::stream::Reader, $request_id: optional String): std::stream::Reader | ErrorValue
{
    let $session = TextSession(request_id: $request_id)
    std::stream::Reader(
        next: fn (): optional String | Error { $session.next $events },
        result: fn (): Response | Error { $session.result },
        close: fn (): () | ErrorValue { $events.close },
    )
}
pub fn Client::events($request: Request): std::stream::Reader | ErrorValue
{
    let $body = std::json::set (std::json::wrap $request) "/stream" true
    let $reply = $self.::transport.post "responses" (std::net::http::json_body $body)
    $reply.require_success
    (std::net::sse::read $reply).read_as Event
}
pub fn Client::stream_text($request: Request): std::stream::Reader | ErrorValue
{
    let $body = std::json::set (std::json::wrap $request) "/stream" true
    let $reply = $self.::transport.post "responses" (std::net::http::json_body $body)
    $reply.require_success
    let $events = (std::net::sse::read $reply).read_as Event
    text_stream $events ($reply.headers.get "x-request-id")
}
